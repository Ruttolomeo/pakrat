# Il .pak non contiene l'ID Nexus della mod: senza quello non si puo' sapere
# quale pagina interrogare. Lo si ricava dal link nxm:// (automatico) oppure
# lo si registra a mano una volta con "pakrat link". La mappatura vive qui.
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
NEXUS_API_BASE = "https://api.nexusmods.com/v1/games"
NEXUS_GAME = "baldursgate3"
NEXUS_API = f"{NEXUS_API_BASE}/{NEXUS_GAME}"
USER_AGENT = "pakrat/1.0"


def load_config():
    try:
        with open(CONFIG_FILE) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        cfg = {}
    except json.JSONDecodeError as ex:
        raise SystemExit(f"config.json illeggibile ({ex}). Correggilo o cancellalo: {CONFIG_FILE}")
    cfg.setdefault("nexus_api_key", "")
    cfg.setdefault("mods", {})
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.chmod(tmp, 0o600)          # contiene la API key
    os.replace(tmp, CONFIG_FILE)


class NexusError(Exception):
    pass


def nexus_get(path, api_key, game=NEXUS_GAME):
    """GET sull'API Nexus con messaggi d'errore leggibili.

    'game' e' il domain Nexus del gioco: serve ai backend non-BG3 (vedi mw5.py).
    """
    import urllib.error
    import urllib.request
    if not api_key:
        raise NexusError("API key non configurata: pakrat apikey INCOLLA_LA_CHIAVE")
    req = urllib.request.Request(f"{NEXUS_API_BASE}/{game}{path}",
                                 headers={"apikey": api_key, "User-Agent": USER_AGENT,
                                          "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            remaining = r.headers.get("X-RL-Daily-Remaining")
            if remaining is not None and remaining.isdigit() and int(remaining) < 20:
                sys.stderr.write(f"attenzione: quota API Nexus quasi esaurita ({remaining} richieste)\n")
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as ex:
        if ex.code == 401:
            raise NexusError("API key rifiutata (401): controlla di averla copiata per intero")
        if ex.code == 403:
            raise NexusError("accesso negato (403): la mod potrebbe richiedere un account premium")
        if ex.code == 404:
            raise NexusError("mod non trovata (404): ID Nexus sbagliato o mod rimossa")
        if ex.code == 429:
            raise NexusError("quota API esaurita (429): riprova tra un'ora")
        raise NexusError(f"errore HTTP {ex.code} da Nexus")
    except urllib.error.URLError as ex:
        raise NexusError(f"rete non raggiungibile: {ex.reason}")
    except json.JSONDecodeError:
        raise NexusError("risposta non valida da Nexus")


def parse_nexus_ref(s):
    """Accetta un ID nudo o un URL di Nexus, ritorna l'ID mod."""
    s = s.strip()
    if s.isdigit():
        return int(s)
    import re
    m = re.search(r"baldursgate3/mods/(\d+)", s)
    if m:
        return int(m.group(1))
    raise NexusError(f"non riesco a ricavare un ID Nexus da: {s}")


def cmd_apikey(key):
    key = key.strip()
    if len(key) < 20:
        print("chiave troppo corta: sembra incompleta", file=sys.stderr)
        return 1
    cfg = load_config()
    cfg["nexus_api_key"] = key
    save_config(cfg)
    print(f"API key salvata in {CONFIG_FILE} (permessi 600)")
    return 0


def cmd_link(target, ref):
    """Associa una mod installata al suo ID Nexus."""
    state, _ = build_state()
    mod = None
    if target.isdigit():
        i = int(target) - 1
        if 0 <= i < len(state):
            mod = state[i]
    if mod is None:
        for m in state:
            if m.uuid == target or m.name.lower() == target.lower():
                mod = m
                break
    if mod is None:
        print(f"mod non trovata: {target}", file=sys.stderr)
        return 1
    try:
        nexus_id = parse_nexus_ref(ref)
    except NexusError as ex:
        print(ex, file=sys.stderr)
        return 1
    cfg = load_config()
    cfg["mods"].setdefault(mod.uuid, {})
    cfg["mods"][mod.uuid].update({"nexus_id": nexus_id, "name": mod.name})
    save_config(cfg)
    print(f"{mod.name} -> nexusmods.com/baldursgate3/mods/{nexus_id}")
    return 0


NEXUS_GRAPHQL = "https://api.nexusmods.com/v2/graphql"

# parole troppo comuni nei nomi delle mod per essere discriminanti
_STOPWORDS = {"the", "of", "by", "a", "an", "set", "mod", "for", "and", "bg3",
              "outfit", "version", "new", "my"}

_GQL_SEARCH = """query($f:ModsFilter,$c:Int){
  mods(filter:$f,count:$c,viewUserBlockedContent:true){
    nodes{modId name version adultContent summary uploader{name}}}}"""


def nexus_graphql(query, variables, api_key):
    import urllib.error
    import urllib.request
    if not api_key:
        raise NexusError("API key non configurata")
    body = json.dumps({"query": query, "variables": variables}).encode()
    req = urllib.request.Request(
        NEXUS_GRAPHQL, data=body,
        headers={"apikey": api_key, "Content-Type": "application/json",
                 "User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            d = json.loads(r.read().decode())
    except urllib.error.HTTPError as ex:
        if ex.code == 401:
            raise NexusError("API key rifiutata (401)")
        if ex.code == 429:
            raise NexusError("quota API esaurita (429)")
        raise NexusError(f"errore HTTP {ex.code} da Nexus")
    except urllib.error.URLError as ex:
        raise NexusError(f"rete non raggiungibile: {ex.reason}")
    except json.JSONDecodeError:
        raise NexusError("risposta non valida da Nexus")
    if "errors" in d:
        raise NexusError(d["errors"][0].get("message", "errore GraphQL"))
    return d.get("data", {})


def nexus_search(term, api_key, count=25):
    data = nexus_graphql(_GQL_SEARCH, {
        "f": {"gameDomainName": [{"value": "baldursgate3", "op": "EQUALS"}],
              "name": [{"value": term, "op": "WILDCARD"}]},
        "c": count}, api_key)
    return data.get("mods", {}).get("nodes", []) or []


def _norm(s):
    import re
    return re.sub(r"[^a-z0-9]+", "", (s or "").lower())


def search_terms(name, folder=""):
    """Genera qualche termine di ricerca da un nome di mod locale.

    I nomi su Nexus differiscono spesso da quelli nel meta.lsx ("Queen Marika Set"
    contro "Queen Marika Outfit By REN"), quindi si cercano sottoinsiemi corti
    invece del nome intero. Il CamelCase va spezzato: 'BasketEquipmentNSFW' da
    solo non trova nulla, 'Basket Equipment' si'.
    """
    import re
    s = re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", name or "")
    s = re.sub(r"[_\-:]+", " ", s)
    words = re.findall(r"[A-Za-z0-9']+", s)
    out = []
    if len(words) >= 2:
        out.append(" ".join(words[:2]))
    sig = [w for w in words if w.lower() not in _STOPWORDS]
    if sig:
        out.append(sig[0])
    if len(sig) >= 2:
        out.append(" ".join(sig[:2]))
    f = re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", folder or "")
    fw = [w for w in re.findall(r"[A-Za-z0-9']+", f) if w.lower() not in _STOPWORDS]
    if fw:
        out.append(fw[0])
    seen, res = set(), []
    for t in out:
        if len(t) > 2 and t.lower() not in seen:
            seen.add(t.lower())
            res.append(t)
    return res[:3]


def match_score(mod, cand):
    """0..1: somiglianza del nome, con bonus se l'autore coincide."""
    import difflib
    s = difflib.SequenceMatcher(None, _norm(mod.name), _norm(cand.get("name"))).ratio()
    up = _norm((cand.get("uploader") or {}).get("name", ""))
    au = _norm(mod.author)
    if au and up and (au == up or au in up or up in au):
        s = min(1.0, s + 0.25)
    return s


def find_candidates(mod, api_key, extra_term=None, limit=12):
    """Cerca su Nexus i possibili corrispondenti di una mod locale, ordinati."""
    terms = [extra_term] if extra_term else search_terms(mod.name, mod.folder)
    cands = {}
    errors = []
    for t in terms:
        try:
            for n in nexus_search(t, api_key):
                cands[n["modId"]] = n
        except NexusError as ex:
            errors.append(f"'{t}': {ex}")
    ranked = sorted(cands.values(), key=lambda c: -match_score(mod, c))
    return [(match_score(mod, c), c) for c in ranked[:limit]], errors


def cmd_match(target=None):
    """Associa le mod a Nexus scegliendo a mano fra i candidati trovati."""
    cfg = load_config()
    if not cfg["nexus_api_key"]:
        print("API key non configurata: pakrat apikey LA_TUA_CHIAVE", file=sys.stderr)
        return 1
    state, _ = build_state()
    pool = [m for m in state if m.has_pak and not m.is_base]
    if target:
        if target.isdigit() and 1 <= int(target) <= len(state):
            pool = [state[int(target) - 1]]
        else:
            pool = [m for m in pool if target.lower() in m.name.lower()]
        if not pool:
            print(f"nessuna mod corrisponde a '{target}'", file=sys.stderr)
            return 1
    else:
        pool = [m for m in pool if not cfg["mods"].get(m.uuid, {}).get("nexus_id")]
        if not pool:
            print("tutte le mod sono gia' associate")
            return 0

    for m in pool:
        print(f"\n=== {m.name}   [autore locale: {m.author or '?'}]")
        term = None
        while True:
            cands, errs = find_candidates(m, cfg["nexus_api_key"], extra_term=term)
            for e in errs:
                print("  avviso:", e)
            if not cands:
                print("  nessun candidato trovato")
            for i, (s, c) in enumerate(cands, 1):
                up = (c.get("uploader") or {}).get("name", "")
                adult = " [adult]" if c.get("adultContent") else ""
                print(f"  {i:2}) {s:.2f}  {c['name'][:44]:44} {up[:14]:14} "
                      f"{str(c.get('version'))[:10]:10}{adult}")
            print("   s) salta   c) cerca con altre parole   q) esci")
            ans = input("  scelta: ").strip().lower()
            if ans == "q":
                return 0
            if ans == "s" or ans == "":
                break
            if ans == "c":
                term = input("  termine di ricerca: ").strip() or None
                continue
            if ans.isdigit() and 1 <= int(ans) <= len(cands):
                c = cands[int(ans) - 1][1]
                cfg["mods"].setdefault(m.uuid, {}).update(
                    {"nexus_id": c["modId"], "name": m.name,
                     "installed_version": m.version,
                     "remote_version": (c.get("version") or "").strip()})
                save_config(cfg)
                print(f"  associata -> mods/{c['modId']} ({c['name']})")
                break
            print("  scelta non valida")
    return 0


def file_md5(path, chunk=1 << 20):
    import hashlib
    h = hashlib.md5()
    with open(path, "rb") as f:
        while True:
            b = f.read(chunk)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def cmd_discover(only_missing=True):
    """Tenta di ricavare gli ID Nexus dall'hash MD5 dei .pak.

    Nexus indicizza l'hash del file caricato dall'autore: funziona se la mod e'
    stata pubblicata come .pak nudo, non se e' dentro un archivio zip/7z (in quel
    caso l'hash indicizzato e' quello dell'archivio, non del .pak estratto).
    Le mod non identificate restano da associare a mano con 'pakrat link'.
    """
    cfg = load_config()
    if not cfg["nexus_api_key"]:
        print("API key non configurata: pakrat apikey LA_TUA_CHIAVE", file=sys.stderr)
        return 1
    state, _ = build_state()
    targets = [m for m in state if m.has_pak and not m.is_base]
    if only_missing:
        targets = [m for m in targets
                   if not cfg["mods"].get(m.uuid, {}).get("nexus_id")]
    if not targets:
        print("nessuna mod da identificare")
        return 0

    found = miss = err = 0
    for m in targets:
        size_mb = os.path.getsize(m.pak) / (1 << 20)
        print(f"{m.name[:38]:38} calcolo hash ({size_mb:.0f} MB)...", end="", flush=True)
        try:
            digest = file_md5(m.pak)
        except OSError as ex:
            print(f" errore lettura: {ex}")
            err += 1
            continue
        try:
            res = nexus_get(f"/mods/md5_search/{digest}.json", cfg["nexus_api_key"])
        except NexusError as ex:
            # 404 = semplicemente nessuna corrispondenza, non un guasto
            if "404" in str(ex) or "non trovata" in str(ex):
                print(" nessuna corrispondenza")
                miss += 1
                continue
            print(f" {ex}")
            err += 1
            continue
        try:
            mod_info = res[0]["mod"]
            nexus_id = mod_info["mod_id"]
            version = (mod_info.get("version") or "").strip()
        except (KeyError, IndexError, TypeError):
            print(" risposta inattesa")
            miss += 1
            continue
        cfg["mods"].setdefault(m.uuid, {}).update(
            {"nexus_id": nexus_id, "name": m.name,
             "installed_version": version or m.version})
        print(f" -> mods/{nexus_id} ({mod_info.get('name', '')[:30]})")
        found += 1
    save_config(cfg)
    print(f"\nidentificate {found}, non trovate {miss}, errori {err}")
    if miss:
        print("per quelle non trovate: pakrat link N URL_DELLA_MOD")
    return 0


