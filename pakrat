HELP = "j/k muovi  J/K riordina  spazio on/off  a aggiungi  d elimina  w salva  r ricarica  q esci"


def tui(stdscr):
    curses.curs_set(0)
    curses.use_default_colors()
    for i in range(1, 8):
        curses.init_pair(i, i, -1)
    C_GREEN, C_RED, C_YELLOW, C_BLUE, C_CYAN = 2, 1, 3, 4, 6

    state, errors = build_state()
    sel = 0
    top = 0
    msg = f"{len([m for m in state if m.enabled])} attive, {len(state)} totali"
    if errors:
        msg += f" - {len(errors)} avvisi (premi e)"
    dirty = False

    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        title = " pakrat "
        stdscr.addnstr(0, 0, title.ljust(w), w, curses.A_REVERSE)
        mark = "*" if dirty else " "
        stdscr.addnstr(0, max(0, w - 12), f"{mark}modifiche ", 11, curses.A_REVERSE)

        rows = h - 4
        if sel < top:
            top = sel
        if sel >= top + rows:
            top = sel - rows + 1

        for i in range(top, min(len(state), top + rows)):
            m = state[i]
            y = 1 + i - top
            attr = curses.A_REVERSE if i == sel else 0
            if m.is_base:
                box, col = "[base]", curses.color_pair(C_BLUE)
            elif not m.has_pak and m.enabled:
                box, col = "[!pak]", curses.color_pair(C_RED)
            elif m.enabled:
                box, col = "[  on]", curses.color_pair(C_GREEN)
            else:
                box, col = "[ off]", curses.color_pair(C_YELLOW)
            num = f"{i+1:2}" if m.enabled else " -"
            line = f" {num} {box} {m.name[:44]:44} {m.version:>12}"
            if m.author:
                line += f"  {m.author[:14]}"
            stdscr.addnstr(y, 0, line.ljust(w)[:w], w, attr | col)

        stdscr.addnstr(h - 2, 0, msg[:w - 1].ljust(w - 1), w - 1, curses.color_pair(C_CYAN))
        stdscr.addnstr(h - 1, 0, HELP[:w - 1].ljust(w - 1), w - 1, curses.A_DIM)
        stdscr.refresh()

        try:
            c = stdscr.getch()
        except KeyboardInterrupt:
            break
        if c in (ord("q"), 27):
            if dirty:
                msg = "ci sono modifiche non salvate: w per salvare, Q per uscire comunque"
                dirty = "asked"
                continue
            break
        if c == ord("Q"):
            break
        if c in (ord("j"), curses.KEY_DOWN):
            sel = min(len(state) - 1, sel + 1)
        elif c in (ord("k"), curses.KEY_UP):
            sel = max(0, sel - 1)
        elif c == ord("g"):
            sel = 0
        elif c == ord("G"):
            sel = len(state) - 1
        elif c in (ord("J"), ord("K")):
            j = sel + (1 if c == ord("J") else -1)
            if 0 <= j < len(state):
                if state[sel].is_base or state[j].is_base:
                    msg = "i moduli base restano in testa, non si spostano"
                else:
                    state[sel], state[j] = state[j], state[sel]
                    sel = j
                    dirty = True
        elif c == ord(" "):
            m = state[sel]
            if m.is_base:
                msg = "i moduli base non si disattivano"
            elif not m.has_pak:
                msg = "nessun .pak per questa voce: solo rimozione possibile"
            else:
                m.enabled = not m.enabled
                dirty = True
                msg = f"{m.name}: {'attiva' if m.enabled else 'disattivata'}"
        elif c == ord("w"):
            ok, res = write_modsettings(state)
            msg = ("salvato: " if ok else "ERRORE: ") + res
            if ok:
                dirty = False
        elif c == ord("r"):
            state, errors = build_state()
            sel = min(sel, len(state) - 1)
            dirty = False
            msg = "ricaricato"
        elif c == ord("e"):
            msg = " | ".join(errors)[:w - 2] if errors else "nessun avviso"
        elif c == ord("a"):
            curses.echo()
            stdscr.addnstr(h - 1, 0, "percorso .pak: ".ljust(w - 1), w - 1)
            stdscr.refresh()
            path = stdscr.getstr(h - 1, 15, 200).decode().strip()
            curses.noecho()
            if path:
                ok, res = install_pak(os.path.expanduser(path))
                msg = res
                if ok:
                    state, errors = build_state()
        elif c == ord("d"):
            m = state[sel]
            if m.is_base:
                msg = "non si elimina un modulo base"
            elif not m.has_pak:
                state.pop(sel)
                sel = max(0, sel - 1)
                dirty = True
                msg = "voce orfana rimossa dal load order"
            else:
                stdscr.addnstr(h - 1, 0, f"eliminare {m.name}? il .pak viene cancellato (s/n) ".ljust(w - 1), w - 1)
                stdscr.refresh()
                if stdscr.getch() in (ord("s"), ord("y")):
                    try:
                        os.remove(m.pak)
                        state.pop(sel)
                        sel = max(0, sel - 1)
                        dirty = True
                        msg = f"eliminato {m.name}"
                    except OSError as ex:
                        msg = f"errore: {ex}"
                else:
                    msg = "annullato"


