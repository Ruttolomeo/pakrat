            print("\nServe la cartella dati di Larian, quella che contiene Mods/ e")
            print("PlayerProfiles/. Di solito sta dentro un prefix Wine, sotto")
            print("drive_c/users/steamuser/AppData/Local/Larian Studios/Baldur's Gate 3\n")
