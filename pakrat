def env_var(name):
    """Legge PAKRAT_<name>, accettando ancora il vecchio BG3MODS_<name>.

    Il tool si chiamava bg3mods finche' gestiva solo Baldur's Gate 3: chi ha
    quelle variabili negli script o nel .zshrc non deve accorgersi del rename.
    """
    return os.environ.get("PAKRAT_" + name) or os.environ.get("BG3MODS_" + name)


_OLD_CONFIG_DIR = os.path.expanduser("~/.config/bg3mods")
CONFIG_DIR = os.path.expanduser(env_var("CONFIG_DIR") or "~/.config/pakrat")
BACKUP_DIR = os.path.join(CONFIG_DIR, "backups")


def _migrate_config_dir():
    """Sposta ~/.config/bg3mods su ~/.config/pakrat al primo avvio dopo il rename.

    Dentro ci sono la API key, le associazioni a Nexus e i backup di
    modsettings.lsx: perderli sarebbe grave, quindi si sposta, non si ricrea.
    """
    # Se il percorso e' stato imposto a mano non e' la cartella di default: non
    # e' una migrazione, e' una scelta dell'utente (o un test). Non toccare nulla.
    if env_var("CONFIG_DIR"):
        return
    if os.path.isdir(CONFIG_DIR) or not os.path.isdir(_OLD_CONFIG_DIR):
        return
    try:
        os.makedirs(os.path.dirname(CONFIG_DIR), exist_ok=True)
        try:
            os.rename(_OLD_CONFIG_DIR, CONFIG_DIR)
            verbo = "spostato"
        except OSError:                    # filesystem diversi: copia e conserva
            shutil.copytree(_OLD_CONFIG_DIR, CONFIG_DIR)
            verbo = ("copiato (l'originale resta in %s: contiene la API key, "
                     "cancellalo quando hai verificato)" % _OLD_CONFIG_DIR)
        sys.stderr.write(f"config {verbo}: {_OLD_CONFIG_DIR} -> {CONFIG_DIR}\n")
    except OSError as ex:
        sys.stderr.write(f"attenzione: config non migrato ({ex}); "
                         f"spostalo a mano da {_OLD_CONFIG_DIR}\n")
        return
    # l'handler nxm:// punta ancora al vecchio eseguibile: va rigenerato
    if os.path.isfile(os.path.expanduser(
            "~/.local/share/applications/bg3mods-nxm.desktop")):
        sys.stderr.write("l'handler nxm:// punta ancora a bg3mods: "
                         "rilancia 'pakrat handler'\n")


_migrate_config_dir()

# Sotto-percorso della cartella dati di Larian dentro un prefix Wine/Proton.
_LARIAN_SUB = "drive_c/users/steamuser/AppData/Local/Larian Studios/Baldur's Gate 3"
_STEAM_APPID = "1086940"


def _looks_like_larian(p):
    return bool(p) and (os.path.isdir(os.path.join(p, "Mods"))
                        or os.path.isfile(os.path.join(p, "PlayerProfiles/Public/modsettings.lsx")))


def _steam_libraries():
    """Legge libraryfolders.vdf per trovare tutte le librerie Steam."""
    libs = []
    for base in ("~/.local/share/Steam", "~/.steam/steam", "~/.steam/root"):
        vdf = os.path.expanduser(os.path.join(base, "steamapps/libraryfolders.vdf"))
        if not os.path.isfile(vdf):
            continue
        try:
            import re
            txt = open(vdf, encoding="utf-8", errors="replace").read()
            libs += re.findall(r'"path"\s+"([^"]+)"', txt)
        except OSError:
            pass
        libs.append(os.path.expanduser(base))
    return libs


def detect_larian_dirs():
    """Cerca la cartella dati di BG3 nei posti dove finisce di solito.

    Copre Steam (compatdata), Heroic, Lutris, Bottles e i prefix Wine generici.
    Su installazioni non standard si usa la chiave 'larian_dir' nel config o la
    variabile d'ambiente PAKRAT_LARIAN.
    """
    import glob
    cands = []

    env = env_var("LARIAN")
    if env:
        cands.append(os.path.expanduser(env))

    # Steam: compatdata/1086940 in ogni libreria
    for lib in _steam_libraries():
        cands.append(os.path.join(lib, "steamapps/compatdata", _STEAM_APPID, "pfx", _LARIAN_SUB))

    # Heroic / Lutris / Bottles / prefix generici
    patterns = [
        "~/Games/Heroic/Prefixes/*/*/" + _LARIAN_SUB,
        "~/Games/Heroic/Prefixes/*/" + _LARIAN_SUB,
        "~/.var/app/com.heroicgameslauncher.hgl/config/heroic/Prefixes/*/*/" + _LARIAN_SUB,
        "/mnt/*/HeroicGames/Wine Prefixes/*/" + _LARIAN_SUB,
        "/media/*/HeroicGames/Wine Prefixes/*/" + _LARIAN_SUB,
        "~/Games/*/" + _LARIAN_SUB,
        "~/.local/share/lutris/prefixes/*/" + _LARIAN_SUB,
        "~/.var/app/com.usebottles.bottles/data/bottles/bottles/*/" + _LARIAN_SUB,
        "~/.wine/" + _LARIAN_SUB,
    ]
    for pat in patterns:
        cands += sorted(glob.glob(os.path.expanduser(pat)))

    # Windows nativo, per completezza
    if os.name == "nt":
        la = os.environ.get("LOCALAPPDATA")
        if la:
            cands.append(os.path.join(la, "Larian Studios", "Baldur's Gate 3"))

    seen, out = set(), []
    for c in cands:
        c = os.path.normpath(c)
        if c not in seen and _looks_like_larian(c):
            seen.add(c)
            out.append(c)
    return out


def _resolve_larian():
    # 1) config esplicito  2) rilevamento automatico  3) niente
    try:
        with open(os.path.join(CONFIG_DIR, "config.json")) as f:
            cfg = json.load(f)
        p = cfg.get("larian_dir")
        if p and _looks_like_larian(os.path.expanduser(p)):
            return os.path.expanduser(p)
    except (OSError, json.JSONDecodeError):
        pass
    found = detect_larian_dirs()
    return found[0] if found else ""


