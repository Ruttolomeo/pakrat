def nexus_user_info(api_key, cache=True):
    """Dati dell'account, con cache: serve a sapere se e' premium.

    Gli account non premium non possono ottenere link di download dall'API senza
    i parametri key/expires, che arrivano solo da un link nxm:// generato dal
    sito. Il flusso di aggiornamento cambia di conseguenza.
    """
    import urllib.error
    import urllib.request
    cfg = load_config()
    if cache and cfg.get("account", {}).get("checked_at", 0) > time.time() - 86400:
        return cfg["account"]
    if not api_key:
        raise NexusError("API key non configurata")
    req = urllib.request.Request(
        "https://api.nexusmods.com/v1/users/validate.json",
        headers={"apikey": api_key, "User-Agent": USER_AGENT,
                 "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            d = json.loads(r.read().decode())
    except urllib.error.HTTPError as ex:
        if ex.code == 401:
            raise NexusError("API key rifiutata (401)")
        raise NexusError(f"errore HTTP {ex.code} da Nexus")
    except urllib.error.URLError as ex:
        raise NexusError(f"rete non raggiungibile: {ex.reason}")
    acct = {"name": d.get("name", ""),
            "is_premium": bool(d.get("is_premium")),
            "checked_at": int(time.time())}
    cfg["account"] = acct
    save_config(cfg)
    return acct


def is_premium(api_key):
    try:
        return nexus_user_info(api_key).get("is_premium", False)
    except NexusError:
        return False


def mod_file_page_url(mod_id, file_id=None):
    """Pagina dei file della mod. Con nmm=1 il sito offre il download via manager,
    che sugli account free e' l'unico modo per ottenere un link valido."""
    u = f"https://www.nexusmods.com/baldursgate3/mods/{mod_id}?tab=files&nmm=1"
    if file_id:
        u += f"&file_id={file_id}"
    return u


def nexus_files(mod_id, api_key):
    return nexus_get(f"/mods/{mod_id}/files.json", api_key).get("files", [])


def pick_main_file(files):
    """Sceglie il file da scaricare: il primario, altrimenti il MAIN piu' recente."""
    usable = [f for f in files
              if str(f.get("category_name") or "").upper() not in ("OLD_VERSION", "ARCHIVED")]
    if not usable:
        return None
    primary = [f for f in usable if f.get("is_primary")]
    if primary:
        return primary[0]
    main = [f for f in usable if str(f.get("category_name") or "").upper() == "MAIN"]
    pool = main or usable
    return max(pool, key=lambda f: f.get("uploaded_timestamp") or 0)


def download_url(url, dest, progress=None):
    """Scarica su file temporaneo e rinomina solo a download completo."""
    import urllib.parse
    import urllib.request
    # i link del CDN Nexus contengono spazi non codificati nel nome file
    p = urllib.parse.urlsplit(url)
    url = urllib.parse.urlunsplit(
        (p.scheme, p.netloc, urllib.parse.quote(p.path, safe="/%"), p.query, p.fragment))
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    tmp = dest + ".part"
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            total = int(r.headers.get("Content-Length") or 0)
            got = 0
            with open(tmp, "wb") as f:
                while True:
                    chunk = r.read(1 << 18)
                    if not chunk:
                        break
                    f.write(chunk)
                    got += len(chunk)
                    if progress:
                        progress(got, total)
        os.replace(tmp, dest)
        return dest
    except Exception:
        if os.path.exists(tmp):
            os.remove(tmp)
        raise


def extract_paks(archive, outdir):
    """Estrae i .pak da un archivio. Ritorna la lista dei file estratti."""
    import subprocess
    import zipfile
    os.makedirs(outdir, exist_ok=True)
    low = archive.lower()
    if low.endswith(".pak"):
        dest = os.path.join(outdir, os.path.basename(archive))
        shutil.copy2(archive, dest)
        return [dest]
    if low.endswith(".zip"):
        out = []
        with zipfile.ZipFile(archive) as z:
            for n in z.namelist():
                if n.lower().endswith(".pak"):
                    target = os.path.join(outdir, os.path.basename(n))
                    with z.open(n) as src, open(target, "wb") as dst:
                        shutil.copyfileobj(src, dst)
                    out.append(target)
        return out
    # rar / 7z / altro: delega a 7z, che li gestisce quasi tutti
    tool = shutil.which("7z") or shutil.which("7za")
    if low.endswith(".rar") and shutil.which("unrar"):
        tool = None
        cmd = ["unrar", "x", "-y", "-idq", archive, outdir + os.sep]
    elif tool:
        cmd = [tool, "x", "-y", f"-o{outdir}", archive]
    else:
        raise RuntimeError(f"nessun estrattore disponibile per {os.path.basename(archive)}")
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"estrazione fallita: {(r.stderr or r.stdout)[:200]}")
    out = []
    for root, _dirs, files in os.walk(outdir):
        for fn in files:
            if fn.lower().endswith(".pak"):
                out.append(os.path.join(root, fn))
    return out


def update_mod(mod, entry, api_key, log=print):
    """Scarica e installa la versione nuova di una mod. Ritorna (ok, messaggio).

    Sostituisce il .pak solo se quello scaricato ha lo stesso UUID: cosi' il posto
    nel load order e le altre voci di modsettings.lsx restano valide. Il vecchio
    file viene tenuto da parte finche' il nuovo non e' a posto.
    """
    mod_id = entry.get("nexus_id")
    if not mod_id:
        return False, "non associata a Nexus"
    try:
        files = nexus_files(mod_id, api_key)
    except NexusError as ex:
        return False, str(ex)
    f = pick_main_file(files)
    if not f:
        return False, "nessun file scaricabile (solo versioni vecchie o archiviate)"
    remote_ver = (f.get("version") or "").strip()
    if entry.get("installed_file_id") == f["file_id"]:
        return False, f"gia' aggiornata ({remote_ver})"

    # Account non premium: l'API non rilascia link diretti. L'unica via legittima
    # e' il pulsante "Mod Manager Download" sul sito, che genera un nxm:// con
    # key+expires; lo raccoglie il nostro handler. Segnaliamo la pagina da aprire.
    if not is_premium(api_key):
        return False, ("richiede download dal browser (account non premium): "
                       + mod_file_page_url(mod_id, f["file_id"]))

    try:
        links = nexus_get(f"/mods/{mod_id}/files/{f['file_id']}/download_link.json", api_key)
    except NexusError as ex:
        if "403" in str(ex) or "premium" in str(ex).lower():
            return False, ("download diretto negato: "
                           + mod_file_page_url(mod_id, f["file_id"]))
        return False, f"link non ottenibile: {ex}"
    if not links:
        return False, ("nessun link di download: "
                       + mod_file_page_url(mod_id, f["file_id"]))

    cache = os.path.join(CONFIG_DIR, "cache")
    os.makedirs(cache, exist_ok=True)
    archive = os.path.join(cache, f["file_name"])
    log(f"  scarico {f['file_name']} ({f.get('size_kb', 0)/1024:.1f} MB)")
    try:
        download_url(links[0]["URI"], archive)
    except Exception as ex:
        return False, f"download fallito: {ex}"

    tmpdir = os.path.join(cache, f"extract-{mod_id}")
    shutil.rmtree(tmpdir, ignore_errors=True)
    try:
        paks = extract_paks(archive, tmpdir)
    except Exception as ex:
        shutil.rmtree(tmpdir, ignore_errors=True)
        return False, str(ex)
    if not paks:
        shutil.rmtree(tmpdir, ignore_errors=True)
        return False, "l'archivio non contiene .pak (installazione manuale)"

    # cerca il .pak con lo stesso UUID della mod installata
    chosen = None
    for p in paks:
        try:
            nm = mod_from_pak(p)
        except Exception:
            continue
        if nm and nm.uuid == mod.uuid:
            chosen = (p, nm)
            break
    if chosen is None:
        shutil.rmtree(tmpdir, ignore_errors=True)
        names = ", ".join(os.path.basename(p) for p in paks[:3])
        return False, f"nessun .pak con lo stesso UUID (trovati: {names}) - installa a mano"

    src, newmod = chosen
    old = mod.pak
    backup = old + ".old"
    try:
        if os.path.exists(old):
            os.replace(old, backup)
        shutil.copy2(src, os.path.join(MODS_DIR, os.path.basename(old)))
    except OSError as ex:
        if os.path.exists(backup) and not os.path.exists(old):
            os.replace(backup, old)          # rimette il vecchio
        shutil.rmtree(tmpdir, ignore_errors=True)
        return False, f"sostituzione fallita: {ex}"

    # il vecchio .pak non si butta: si mette da parte per poter tornare indietro
    if os.path.exists(backup):
        olddir = os.path.join(CONFIG_DIR, "old-paks")
        os.makedirs(olddir, exist_ok=True)
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        kept = os.path.join(olddir, f"{os.path.basename(old)}.{stamp}")
        try:
            shutil.move(backup, kept)
            entry["previous_pak"] = kept
        except OSError:
            os.remove(backup)
        # i .pak arrivano a centinaia di MB: si tengono solo le ultime 3 versioni
        # sostituite di questa mod, le piu' vecchie si buttano
        prefix = os.path.basename(old) + "."
        older = sorted(f for f in os.listdir(olddir) if f.startswith(prefix))
        for f in older[:-3]:
            try:
                os.remove(os.path.join(olddir, f))
            except OSError:
                pass
    shutil.rmtree(tmpdir, ignore_errors=True)
    entry["installed_version"] = remote_ver or newmod.version
    entry["installed_file_id"] = f["file_id"]
    entry["remote_version"] = remote_ver
    return True, f"aggiornata a {remote_ver or newmod.version}"


def cmd_update(target=None):
    cfg = load_config()
    if not cfg["nexus_api_key"]:
        print("API key non configurata: pakrat apikey LA_TUA_CHIAVE", file=sys.stderr)
        return 1
    state, _ = build_state()
    pool = [m for m in state
            if m.has_pak and cfg["mods"].get(m.uuid, {}).get("nexus_id")]
    if target:
        if target.isdigit() and 1 <= int(target) <= len(state):
            pool = [state[int(target) - 1]]
        else:
            pool = [m for m in pool if target.lower() in m.name.lower()]
    if not pool:
        print("nessuna mod associata a Nexus da aggiornare "
              "(usa 'pakrat match' per associarle)")
        return 1
    ok = fail = 0
