            continue
        if ans.isdigit() and 1 <= int(ans) <= len(found):
            ok, msg = set_larian_dir(found[int(ans) - 1])
            if ok:
                print(f"\nsalvato: {msg}")
                return 0
            print(f"non va bene: {msg}\n")
            continue
        print("scelta non valida")


