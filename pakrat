BACKEND_ALIASES = {"cp": "cp2077", "cyberpunk": "cp2077", "cyberpunk2077": "cp2077"}


def mw5_domain():
    """Domain Nexus di MechWarrior 5, senza dover caricare il backend."""
    return BACKENDS["mw5"][2]


def backend_for_domain(domain):
    """Nome del backend che gestisce un domain Nexus, o None."""
    d = str(domain or "").lower()
    for name, (_f, _m, dom) in BACKENDS.items():
        if dom == d:
            return name
    return None


def load_backend(name):
    """Carica il backend di un gioco accanto a questo script, o None se manca.

    pakrat non ha estensione .py, quindi il backend non puo' importarlo con un
    import normale: ci registriamo in sys.modules come 'pakrat_core' e il modulo
    ci ritrova da la', senza rieseguire questo file.
    """
    import importlib.machinery
    import importlib.util
    name = BACKEND_ALIASES.get(name, name)
    spec_info = BACKENDS.get(name)
    if spec_info is None:
        return None
    fname, modname, _dom = spec_info
    cached = sys.modules.get(modname)
    if cached is not None:
        return cached
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), fname)
    if not os.path.isfile(path):
        return None
    me = sys.modules.get(__name__)     # "__main__" da CLI, "pakrat_core" dalla GUI
    if me is not None:
        sys.modules.setdefault("pakrat_core", me)
    loader = importlib.machinery.SourceFileLoader(modname, path)
    spec = importlib.util.spec_from_loader(modname, loader)
    m = importlib.util.module_from_spec(spec)
    sys.modules[modname] = m
    loader.exec_module(m)
    return m


def load_mw5():
    """Compatibilita': la GUI e gli script esistenti chiamano ancora questa."""
    return load_backend("mw5")


def cmd_nxm(url):
    """Handler dei link nxm:// (pulsante 'Mod Manager Download')."""
    import urllib.parse
    p = urllib.parse.urlparse(url)
    if p.scheme != "nxm":
        print(f"non e' un link nxm://: {url}", file=sys.stderr)
        return 1
    game = p.netloc
    name = backend_for_domain(game)
    if name:
        be = load_backend(name)
        if be is None:
            print(f"backend {name} non installato "
                  f"(manca {BACKENDS[name][0]} accanto a pakrat)", file=sys.stderr)
            return 1
        return be.cmd_nxm(url)
    if game.lower() != NEXUS_GAME:
        print(f"gioco non gestito da questo tool: {game}", file=sys.stderr)
        return 1
    parts = [x for x in p.path.split("/") if x]
    try:
        mod_id = int(parts[parts.index("mods") + 1])
        file_id = int(parts[parts.index("files") + 1])
    except (ValueError, IndexError):
        print(f"link nxm malformato: {url}", file=sys.stderr)
        return 1
    q = urllib.parse.parse_qs(p.query)
    key = q.get("key", [None])[0]
    expires = q.get("expires", [None])[0]

    cfg = load_config()
    api_key = cfg["nexus_api_key"]
    if not api_key:
        print("API key non configurata: pakrat apikey LA_TUA_CHIAVE", file=sys.stderr)
        return 1
    if expires and expires.isdigit() and int(expires) < time.time():
        print("link scaduto: rigenera il download da Nexus", file=sys.stderr)
        return 1

    path = f"/mods/{mod_id}/files/{file_id}/download_link.json"
    if key:
        path += f"?key={urllib.parse.quote(key)}&expires={expires}"
    try:
        links = nexus_get(path, api_key)
    except NexusError as ex:
        print(f"impossibile ottenere il link di download: {ex}", file=sys.stderr)
        return 1
    if not links:
        print("Nexus non ha restituito alcun link (account non premium senza chiave nel link?)", file=sys.stderr)
        return 1

    dl = links[0].get("URI")
    fname = urllib.parse.unquote(os.path.basename(urllib.parse.urlparse(dl).path))
    dest_dir = os.path.expanduser("~/Downloads")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, fname)

    import urllib.request
    print(f"scarico {fname} ...")
    try:
        req = urllib.request.Request(dl, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=60) as r, open(dest + ".part", "wb") as f:
            shutil.copyfileobj(r, f)
        os.replace(dest + ".part", dest)
    except Exception as ex:
        if os.path.exists(dest + ".part"):
            os.remove(dest + ".part")
        print(f"download fallito: {ex}", file=sys.stderr)
        return 1

    # registra la mappatura, cosi' i check successivi funzionano
    try:
        info = nexus_get(f"/mods/{mod_id}.json", api_key)
        version = _nexus_version_of(info)
    except NexusError:
        version = ""

    if dest.lower().endswith(".pak"):
        ok, res = install_pak(dest)
        print(res)
        if ok:
            m = mod_from_pak(dest)
            if m:
                cfg["mods"].setdefault(m.uuid, {}).update(
                    {"nexus_id": mod_id, "name": m.name, "installed_version": version or m.version})
                save_config(cfg)
                print(f"associata a nexusmods.com/baldursgate3/mods/{mod_id}")
        print("apri 'pakrat' per attivarla nel load order")
    else:
        print(f"scaricato in {dest}")
        print("e' un archivio (zip/rar): estrai il .pak e usa 'pakrat add FILE.pak'")
    return 0


DESKTOP_ENTRY = """[Desktop Entry]
Type=Application
Name=pakrat (nxm handler)
Exec={exe} nxm %u
NoDisplay=true
MimeType=x-scheme-handler/nxm;
Terminal=true
"""


def cmd_handler():
    exe = os.path.abspath(sys.argv[0])
    apps = os.path.expanduser("~/.local/share/applications")
    os.makedirs(apps, exist_ok=True)
    path = os.path.join(apps, "pakrat-nxm.desktop")
    with open(path, "w") as f:
        f.write(DESKTOP_ENTRY.format(exe=exe))
    # via la voce del vecchio nome, altrimenti resta a competere per nxm://
    old = os.path.join(apps, "bg3mods-nxm.desktop")
    if os.path.isfile(old):
        os.remove(old)
        print(f"rimosso l'handler del vecchio nome ({old})")
    os.system(f"update-desktop-database {apps} 2>/dev/null")
    os.system("xdg-mime default pakrat-nxm.desktop x-scheme-handler/nxm 2>/dev/null")
    print(f"handler nxm:// registrato ({path})")
    print("verifica: xdg-mime query default x-scheme-handler/nxm")
    return 0


