def reload_paths():
    """Rilegge i percorsi dopo che la configurazione e' cambiata."""
    global LARIAN, MODS_DIR, MODSETTINGS
    LARIAN = _resolve_larian()
    MODS_DIR = os.path.join(LARIAN, "Mods") if LARIAN else ""
    MODSETTINGS = (os.path.join(LARIAN, "PlayerProfiles/Public/modsettings.lsx")
