    if found:
        print("Installazioni trovate:")
        for i, p in enumerate(found, 1):
            n = len([f for f in os.listdir(os.path.join(p, "Mods"))
                     if f.lower().endswith(".pak")]) if os.path.isdir(os.path.join(p, "Mods")) else 0
            print(f"  {i}) {p}\n     ({n} .pak installati)")
    else:
        print("Nessuna installazione rilevata automaticamente.")
    print("\n  a) indica un percorso a mano")
