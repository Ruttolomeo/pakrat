def main():
    args = sys.argv[1:]
    if args and args[0] == "setup":
        return cmd_setup()

    # I comandi di altri giochi non devono pretendere un'installazione di BG3.
    if args and BACKEND_ALIASES.get(args[0], args[0]) in BACKENDS:
        name = BACKEND_ALIASES.get(args[0], args[0])
        be = load_backend(name)
        if be is None:
            print(f"backend {name} non installato "
                  f"(manca {BACKENDS[name][0]} accanto a pakrat)", file=sys.stderr)
            return 1
        return be.main(args[1:])
    if args and args[0] == "nxm" and len(args) > 1:
        import urllib.parse
        if backend_for_domain(urllib.parse.urlparse(args[1]).netloc):
            return cmd_nxm(args[1])

    if not LARIAN or not os.path.isdir(LARIAN):
        print("Installazione di Baldur's Gate 3 non trovata.\n\n"
              "Ho cercato nei prefix di Steam, Heroic, Lutris, Bottles e in ~/.wine.\n"
              "Se BG3 e' altrove, indica la cartella dati di Larian in uno dei due modi:\n\n"
              "  - variabile d'ambiente PAKRAT_LARIAN\n"
              f"  - chiave \"larian_dir\" in {os.path.join(CONFIG_DIR, 'config.json')}\n\n"
              "Deve puntare alla cartella che contiene Mods/ e PlayerProfiles/,\n"
              "tipicamente .../AppData/Local/Larian Studios/Baldur's Gate 3\n\n"
              "Oppure lancia:  pakrat setup",
              file=sys.stderr)
        return 1
    if not args:
        curses.wrapper(tui)
        return 0
    cmd = args[0]
    if cmd == "list":
        cmd_list()
    elif cmd == "add":
        if len(args) < 2:
            print("uso: pakrat add FILE.pak", file=sys.stderr)
            return 1
        ok, res = install_pak(os.path.expanduser(args[1]))
        print(res)
        return 0 if ok else 1
    elif cmd == "setup":
        return cmd_setup()
    elif cmd == "backups":
        cmd_backups()
    elif cmd == "apikey":
        if len(args) < 2:
            print("uso: pakrat apikey LA_TUA_CHIAVE", file=sys.stderr)
            return 1
        return cmd_apikey(args[1])
    elif cmd == "link":
        if len(args) < 3:
            print("uso: pakrat link N URL_O_ID_NEXUS", file=sys.stderr)
            return 1
        return cmd_link(args[1], args[2])
    elif cmd == "check":
        return cmd_check()
    elif cmd == "discover":
        return cmd_discover(only_missing="--all" not in args)
    elif cmd == "match":
        return cmd_match(args[1] if len(args) > 1 else None)
    elif cmd == "update":
        return cmd_update(args[1] if len(args) > 1 else None)
    elif cmd == "nxm":
        if len(args) < 2:
            print("uso: pakrat nxm nxm://...", file=sys.stderr)
            return 1
        return cmd_nxm(args[1])
    elif cmd == "handler":
        return cmd_handler()
    elif cmd == "restore":
        if len(args) < 2:
            print("uso: pakrat restore N", file=sys.stderr)
            return 1
        return cmd_restore(args[1])
    else:
        print(__doc__)
        return 1
    return 0


def _run():
    """Entry point con SIGPIPE gestito: 'pakrat list | head' non deve dare traceback."""
    try:
        rc = main()
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        rc = 0
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        rc = 0
    return rc


if __name__ == "__main__":
    sys.exit(_run())
