def validate_larian_dir(path):
    """Controlla che il percorso sia la cartella dati di Larian.

    Ritorna (ok, messaggio). Il messaggio spiega cosa manca, cosi' chi sbaglia
    cartella capisce dove guardare invece di ricevere un no secco.
    """
    if not path:
        return False, "nessun percorso indicato"
    p = os.path.expanduser(path.strip())
    if not os.path.exists(p):
        return False, "il percorso non esiste"
    if not os.path.isdir(p):
        return False, "non e' una cartella"
    has_mods = os.path.isdir(os.path.join(p, "Mods"))
    has_prof = os.path.isdir(os.path.join(p, "PlayerProfiles"))
    if not has_mods and not has_prof:
        # errore tipico: si indica la cartella del gioco invece dei dati utente
        if os.path.isdir(os.path.join(p, "bin")) or os.path.isdir(os.path.join(p, "Data")):
            return False, ("questa e' la cartella di installazione del gioco. "
                           "Serve quella dei dati utente, sotto "
                           "AppData/Local/Larian Studios/Baldur's Gate 3")
        return False, "qui non ci sono ne' Mods/ ne' PlayerProfiles/"
    if not os.access(p, os.W_OK):
        return False, "cartella non scrivibile"
    note = ""
    if not has_mods:
        note = " (la cartella Mods/ verra' creata al primo .pak installato)"
    return True, "ok" + note


def set_larian_dir(path):
    """Salva la cartella di gioco nel config e ricarica i percorsi."""
    ok, msg = validate_larian_dir(path)
    if not ok:
        return False, msg
    p = os.path.expanduser(path.strip())
    cfg = load_config()
    cfg["larian_dir"] = p
    save_config(cfg)
    reload_paths()
    return True, p

# Moduli base del gioco: presenti in modsettings ma senza .pak in Mods/.
# Vanno lasciati in testa e mai rimossi, altrimenti il gioco non parte.
BASE_MODULES = {"GustavX", "HonourX", "Gustav", "GustavDev", "Shared", "SharedDev"}

ENTRY_SIZE = 272


# ------------------------------------------------------------------- LSPK ---
def _decompress(data, flags, uncompressed_size):
    method = flags & 0x0F
    if method == 0:
        return data
    if method == 1:
        return zlib.decompress(data)
    if method == 2:
        return lz4.block.decompress(data, uncompressed_size=uncompressed_size)
    raise ValueError(f"metodo di compressione sconosciuto: {method}")


def pak_list_files(path):
    with open(path, "rb") as f:
        magic, version = struct.unpack("<4sI", f.read(8))
        if magic != b"LSPK":
            raise ValueError("non e' un archivio LSPK")
        if version != 18:
            raise ValueError(f"versione LSPK non supportata: {version}")
        filelist_offset, _ = struct.unpack("<QI", f.read(12))

        f.seek(filelist_offset)
        num_files, compressed_size = struct.unpack("<II", f.read(8))
        raw = lz4.block.decompress(f.read(compressed_size),
                                   uncompressed_size=num_files * ENTRY_SIZE)
        out = []
        for i in range(num_files):
            e = raw[i * ENTRY_SIZE:(i + 1) * ENTRY_SIZE]
            name = e[:256].split(b"\x00")[0].decode("utf-8", "replace")
            off1, off2, _part, flags, size_disk, size_unc = struct.unpack_from("<IHBBII", e, 256)
            out.append((name, off1 | (off2 << 32), size_disk, size_unc, flags))
        return out


def pak_read_meta(path):
    for name, offset, size_disk, size_unc, flags in pak_list_files(path):
        if name.lower().endswith("meta.lsx"):
            with open(path, "rb") as f:
                f.seek(offset)
                return _decompress(f.read(size_disk), flags, size_unc)
    return None


def decode_version64(v):
    """Version64 di Larian -> stringa leggibile."""
    try:
        v = int(v)
    except (TypeError, ValueError):
        return "?"
    if v == 0:
        return "0.0.0.0"
    return f"{v >> 55}.{(v >> 47) & 0xFF}.{(v >> 31) & 0xFFFF}.{v & 0x7FFFFFFF}"


# ------------------------------------------------------------------- model ---
class Mod:
    def __init__(self, uuid, folder, name, version64, author="", pak=None,
                 md5="", publish_handle="0", is_base=False):
        self.uuid = uuid
        self.folder = folder
        self.name = name or folder
        self.version64 = str(version64 or "0")
        self.author = author
        self.pak = pak
        self.md5 = md5
        self.publish_handle = publish_handle
        self.is_base = is_base
        self.enabled = False

    @property
    def version(self):
        return decode_version64(self.version64)

    @property
    def has_pak(self):
        return self.pak is not None and os.path.exists(self.pak)


def _attrs(node):
    out = {}
    for a in node.findall("attribute"):
        out[a.get("id")] = a.get("value")
    return out


def mod_from_pak(path):
    meta = pak_read_meta(path)
    if meta is None:
        return None
    text = meta.decode("utf-8-sig", "replace")
    root = ET.fromstring(text)
    for node in root.iter("node"):
        if node.get("id") == "ModuleInfo":
            a = _attrs(node)
            uuid = a.get("UUID")
            if not uuid:
                return None
            return Mod(uuid, a.get("Folder", ""), a.get("Name", ""),
                       a.get("Version64") or a.get("Version") or "0",
                       a.get("Author", ""), pak=path, md5=a.get("MD5", ""))
    return None


def scan_mods():
    """Tutti i .pak presenti in Mods/, indicizzati per UUID."""
    found = {}
    errors = []
    if not os.path.isdir(MODS_DIR):
        return found, [f"cartella Mods non trovata: {MODS_DIR}"]
    for fn in sorted(os.listdir(MODS_DIR)):
        if not fn.lower().endswith(".pak"):
            continue
        p = os.path.join(MODS_DIR, fn)
        try:
            m = mod_from_pak(p)
            if m is None:
                errors.append(f"{fn}: nessun meta.lsx (probabile mod di override, non serve in modsettings)")
            else:
                found[m.uuid] = m
        except Exception as ex:
            errors.append(f"{fn}: {ex}")
    return found, errors


def read_modsettings():
    """Ritorna la lista ordinata di Mod attivi come da modsettings.lsx."""
    if not os.path.exists(MODSETTINGS):
        return []
    root = ET.parse(MODSETTINGS).getroot()
    order = []
    for node in root.iter("node"):
        if node.get("id") != "Mods":
            continue
        children = node.find("children")
        if children is None:
            continue
        for desc in children.findall("node"):
            if desc.get("id") != "ModuleShortDesc":
                continue
            a = _attrs(desc)
            uuid = a.get("UUID")
            if not uuid:
                continue
            folder = a.get("Folder", "")
            order.append(Mod(uuid, folder, a.get("Name", ""),
                             a.get("Version64", "0"), md5=a.get("MD5", ""),
                             publish_handle=a.get("PublishHandle", "0"),
                             is_base=folder in BASE_MODULES))
    return order


def build_state():
    """Fonde modsettings.lsx e i .pak presenti in un'unica lista ordinata."""
    paks, errors = scan_mods()
    active = read_modsettings()

    state = []
    seen = set()
    for m in active:
        seen.add(m.uuid)
        pak = paks.get(m.uuid)
        if pak is not None:
            pak.enabled = True
            pak.publish_handle = m.publish_handle
            pak.md5 = m.md5 or pak.md5
            state.append(pak)
        else:
            # attivo ma senza .pak: modulo base, oppure .pak cancellato
            m.enabled = True
            state.append(m)

    for uuid, m in sorted(paks.items(), key=lambda kv: kv[1].name.lower()):
        if uuid not in seen:
            m.enabled = False
            state.append(m)
    return state, errors


# ------------------------------------------------------------- scrittura ----
LSX_HEADER = '''<?xml version="1.0" encoding="UTF-8"?>
<save>
    <version major="4" minor="8" revision="0" build="700"/>
    <region id="ModuleSettings">
        <node id="root">
            <children>
                <node id="Mods">
                    <children>
'''
LSX_FOOTER = '''                    </children>
                </node>
            </children>
        </node>
    </region>
</save>
'''


def _esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def backup_modsettings():
    os.makedirs(BACKUP_DIR, exist_ok=True)
    if not os.path.exists(MODSETTINGS):
        return None
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(BACKUP_DIR, f"modsettings-{stamp}.lsx")
    shutil.copy2(MODSETTINGS, dest)
    # tiene gli ultimi 30
    files = sorted(f for f in os.listdir(BACKUP_DIR) if f.startswith("modsettings-"))
    for old in files[:-30]:
        os.remove(os.path.join(BACKUP_DIR, old))
    return dest


def write_modsettings(state):
    """Scrive il load order. Ritorna (ok, messaggio)."""
    enabled = [m for m in state if m.enabled]
    if not enabled:
        return False, "rifiuto di scrivere: nessun modulo attivo"
    # I moduli base devono esserci, altrimenti il gioco non parte.
    if not any(m.is_base or m.folder in BASE_MODULES for m in enabled):
        return False, "rifiuto di scrivere: mancano i moduli base del gioco"

    body = []
    for m in enabled:
        body.append(
            '                        <node id="ModuleShortDesc">\n'
            f'                            <attribute id="Folder" type="LSString" value="{_esc(m.folder)}"/>\n'
            f'                            <attribute id="MD5" type="LSString" value="{_esc(m.md5 or "")}"/>\n'
            f'                            <attribute id="Name" type="LSString" value="{_esc(m.name)}"/>\n'
            f'                            <attribute id="PublishHandle" type="uint64" value="{_esc(m.publish_handle or "0")}"/>\n'
            f'                            <attribute id="UUID" type="guid" value="{_esc(m.uuid)}"/>\n'
            f'                            <attribute id="Version64" type="int64" value="{_esc(m.version64)}"/>\n'
            '                        </node>\n')
    content = LSX_HEADER + "".join(body) + LSX_FOOTER

    # validazione prima di toccare il file vero
    try:
        ET.fromstring(content)
    except ET.ParseError as ex:
        return False, f"XML generato non valido, non scrivo: {ex}"

    bak = backup_modsettings()
    tmp = MODSETTINGS + ".pakrat.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(content)
    os.replace(tmp, MODSETTINGS)
    n = len(enabled)
    return True, f"scritte {n} voci" + (f" (backup: {os.path.basename(bak)})" if bak else "")


def install_pak(src):
    if not os.path.isfile(src):
        return False, f"file non trovato: {src}"
    if not src.lower().endswith(".pak"):
        return False, "non e' un .pak"
    try:
        m = mod_from_pak(src)
    except Exception as ex:
        return False, f"pak illeggibile: {ex}"
    dest = os.path.join(MODS_DIR, os.path.basename(src))
    if os.path.exists(dest):
        return False, f"esiste gia': {os.path.basename(dest)}"
    shutil.copy2(src, dest)
    if m is None:
        return True, f"installato {os.path.basename(dest)} (senza meta.lsx: non va in modsettings)"
    return True, f"installato {m.name} {m.version}"


