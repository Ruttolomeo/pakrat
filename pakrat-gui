class UpdateWorker(QThread):
    """Scarica e installa gli aggiornamenti: rete + I/O, fuori dalla UI."""
    row_done = Signal(str, str)
    finished_all = Signal(str)

    def __init__(self, mods):
        super().__init__()
        self.mods = mods

    def run(self):
        cfg = core.load_config()
        ok = fail = 0
        for m in self.mods:
            entry = cfg["mods"].get(m.uuid, {})
            self.row_done.emit(m.uuid, "aggiornamento...")
            try:
                good, res = core.update_mod(
                    m, entry, cfg["nexus_api_key"],
                    log=lambda s, u=m.uuid: self.row_done.emit(u, s.strip()))
            except Exception as ex:
                good, res = False, f"errore: {ex}"
            self.row_done.emit(m.uuid, res)
            ok += good
            fail += not good
            core.save_config(cfg)
        self.finished_all.emit(f"aggiornate {ok}, non aggiornate {fail}")


class DiscoverWorker(QThread):
    """Hash MD5 + lookup su Nexus: entrambi lenti, fuori dalla UI."""
    row_done = Signal(str, str)
    finished_all = Signal(str)

    def __init__(self, mods):
        super().__init__()
        self.mods = mods

    def run(self):
        cfg = core.load_config()
        found = miss = err = 0
        for m in self.mods:
            self.row_done.emit(m.uuid, "hash...")
            try:
                digest = core.file_md5(m.pak)
            except OSError as ex:
                self.row_done.emit(m.uuid, f"errore: {ex}")
                err += 1
                continue
            try:
                res = core.nexus_get(f"/mods/md5_search/{digest}.json",
                                     cfg["nexus_api_key"])
                info = res[0]["mod"]
            except core.NexusError as ex:
                if "404" in str(ex) or "non trovata" in str(ex):
                    self.row_done.emit(m.uuid, "non su Nexus")
                    miss += 1
                else:
                    self.row_done.emit(m.uuid, f"errore: {ex}")
                    err += 1
                continue
            except (KeyError, IndexError, TypeError):
                self.row_done.emit(m.uuid, "risposta inattesa")
                miss += 1
                continue
            cfg["mods"].setdefault(m.uuid, {}).update(
                {"nexus_id": info["mod_id"], "name": m.name,
                 "installed_version": (info.get("version") or "").strip() or m.version})
            self.row_done.emit(m.uuid, f"id {info['mod_id']}")
            found += 1
        core.save_config(cfg)
        self.finished_all.emit(
            f"identificate {found}, non trovate {miss}" + (f", errori {err}" if err else ""))


class SetupDialog(QDialog):
    """Wizard iniziale: sceglie la cartella dati di BG3.

    Serve quando il rilevamento automatico non trova nulla, e in generale sotto
    Flatpak, dove la sandbox puo' impedire di vedere i prefix: li' l'utente deve
    poter indicare il percorso a mano.
    """

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("pakrat - configurazione")
        self.resize(760, 420)
        self.chosen = None

        lay = QVBoxLayout(self)
        intro = QLabel(
            "<b>Dov'e' installato Baldur's Gate 3?</b><br>"
            "Serve la cartella <i>dati</i> di Larian, quella che contiene "
            "<tt>Mods/</tt> e <tt>PlayerProfiles/</tt> — non quella di installazione "
            "del gioco.")
        intro.setTextFormat(Qt.RichText)
        intro.setWordWrap(True)
        lay.addWidget(intro)

        self.list = QTableWidget(0, 2)
        self.list.setHorizontalHeaderLabels(["Percorso", "Mod"])
        self.list.verticalHeader().setVisible(False)
        self.list.setSelectionBehavior(QTableWidget.SelectRows)
        self.list.setSelectionMode(QTableWidget.SingleSelection)
        self.list.setEditTriggers(QTableWidget.NoEditTriggers)
        self.list.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        self.list.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeToContents)
        self.list.doubleClicked.connect(self.use_selected)
        lay.addWidget(self.list)

        prow = QHBoxLayout()
        self.path_box = QLineEdit()
        self.path_box.setPlaceholderText("...oppure incolla qui un percorso")
        self.path_box.returnPressed.connect(self.use_typed)
        btn_browse = QPushButton("Sfoglia...")
        btn_browse.clicked.connect(self.browse)
        prow.addWidget(self.path_box)
        prow.addWidget(btn_browse)
        lay.addLayout(prow)

        self.info = QLabel("")
        self.info.setWordWrap(True)
        lay.addWidget(self.info)

        brow = QHBoxLayout()
        btn_rescan = QPushButton("Ricerca di nuovo")
        btn_rescan.clicked.connect(self.rescan)
        self.btn_ok = QPushButton("Usa questa cartella")
        self.btn_ok.clicked.connect(self.use_selected)
        btn_quit = QPushButton("Esci")
        btn_quit.clicked.connect(self.reject)
        brow.addWidget(btn_rescan)
        brow.addStretch()
        brow.addWidget(btn_quit)
        brow.addWidget(self.btn_ok)
        lay.addLayout(brow)

        self.rescan()

    def rescan(self):
        found = core.detect_larian_dirs()
        self.found = found
        self.list.setRowCount(len(found))
        for r, p in enumerate(found):
            mods = os.path.join(p, "Mods")
            n = len([f for f in os.listdir(mods)
                     if f.lower().endswith(".pak")]) if os.path.isdir(mods) else 0
            self.list.setItem(r, 0, QTableWidgetItem(p))
            self.list.setItem(r, 1, QTableWidgetItem(str(n)))
        if found:
            self.list.selectRow(0)
            self.info.setText(f"{len(found)} installazioni trovate. "
                              "Scegline una, oppure indica un percorso a mano.")
        else:
            self.info.setText("Nessuna installazione trovata automaticamente. "
                              "Indica il percorso a mano qui sotto.")
        self.btn_ok.setEnabled(bool(found))

    def browse(self):
        d = QFileDialog.getExistingDirectory(
            self, "Cartella dati di Baldur's Gate 3", os.path.expanduser("~"))
        if d:
            self.path_box.setText(d)
            self.use_typed()

    def _apply(self, path):
        ok, msg = core.set_larian_dir(path)
        if ok:
            self.chosen = msg
            self.accept()
        else:
            self.info.setText(f"<span style='color:#cc5555'>{msg}</span>")
            self.info.setTextFormat(Qt.RichText)

    def use_typed(self):
        p = self.path_box.text().strip()
        if p:
            self._apply(p)

    def use_selected(self):
        p = self.path_box.text().strip()
        if p:
            self._apply(p)
            return
        r = self.list.currentRow()
        if 0 <= r < len(self.found):
            self._apply(self.found[r])


