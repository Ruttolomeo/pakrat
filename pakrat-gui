                      f"<i>{mod.author or 'sconosciuto'}</i> &nbsp; versione locale: {mod.version}")
        head.setTextFormat(Qt.RichText)
        lay.addWidget(head)

        srow = QHBoxLayout()
        self.search_box = QLineEdit()
        self.search_box.setPlaceholderText("cerca con altre parole e premi Invio...")
        self.search_box.returnPressed.connect(self.do_search)
        btn_s = QPushButton("Cerca")
        btn_s.clicked.connect(self.do_search)
        srow.addWidget(self.search_box)
        srow.addWidget(btn_s)
        lay.addLayout(srow)

        self.list = QTableWidget(0, 5)
        self.list.setHorizontalHeaderLabels(["Conf.", "Nome su Nexus", "Autore", "Versione", ""])
        self.list.verticalHeader().setVisible(False)
        self.list.setSelectionBehavior(QTableWidget.SelectRows)
        self.list.setSelectionMode(QTableWidget.SingleSelection)
        self.list.setEditTriggers(QTableWidget.NoEditTriggers)
        hh = self.list.horizontalHeader()
        hh.setSectionResizeMode(1, QHeaderView.Stretch)
        for c in (0, 2, 3, 4):
            hh.setSectionResizeMode(c, QHeaderView.ResizeToContents)
        self.list.doubleClicked.connect(self.accept_choice)
        lay.addWidget(self.list)

        self.info = QLabel("ricerca in corso...")
        lay.addWidget(self.info)

        row = QHBoxLayout()
        self.btn_open = QPushButton("Apri pagina su Nexus")
        self.btn_open.clicked.connect(self.open_selected)
        self.btn_ok = QPushButton("Associa la selezionata")
        self.btn_ok.clicked.connect(self.accept_choice)
        btn_skip = QPushButton("Nessuno di questi")
        btn_skip.clicked.connect(self.reject)
        row.addWidget(self.btn_open)
        row.addStretch()
        row.addWidget(btn_skip)
        row.addWidget(self.btn_ok)
        lay.addLayout(row)

        self.start_search(None)

    def start_search(self, term):
        self.info.setText("ricerca in corso...")
        self.btn_ok.setEnabled(False)
        self.worker = SearchWorker(self.mod, self.api_key, term)
        self.worker.done.connect(self.on_results)
        self.worker.start()

    def do_search(self):
        t = self.search_box.text().strip()
        self.start_search(t or None)

    def on_results(self, cands, errs):
        self.cands = cands
        self.list.setRowCount(len(cands))
        for r, (s, c) in enumerate(cands):
            up = (c.get("uploader") or {}).get("name", "")
            cells = [f"{s:.2f}", c["name"], up, str(c.get("version") or ""),
                     "adult" if c.get("adultContent") else ""]
            for col, text in enumerate(cells):
                it = QTableWidgetItem(text)
                if col == 0 and s >= 0.85:
                    it.setForeground(QColor("#33aa55"))
                elif col == 0 and s < 0.6:
                    it.setForeground(QColor("#999999"))
                self.list.setItem(r, col, it)
        msg = f"{len(cands)} candidati" if cands else "nessun candidato: prova altre parole"
        if errs:
            msg += " - " + "; ".join(errs)
        self.info.setText(msg)
        self.btn_ok.setEnabled(bool(cands))
        if cands:
            self.list.selectRow(0)

    def selected(self):
        r = self.list.currentRow()
        return self.cands[r][1] if 0 <= r < len(self.cands) else None

    def open_selected(self):
        c = self.selected()
        if c:
            QDesktopServices.openUrl(
                QUrl(f"https://www.nexusmods.com/baldursgate3/mods/{c['modId']}"))

    def accept_choice(self):
        c = self.selected()
        if c:
            self.chosen = c
            self.accept()


