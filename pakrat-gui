class ChooseGameDialog(QDialog):
    """Selettore di gioco mostrato all'avvio (e da 'Cambia gioco...' nel menu)."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("pakrat - scegli il gioco")
        self.resize(420, 300)
        self.chosen = None

        lay = QVBoxLayout(self)
        lay.addWidget(QLabel("<b>Quale gioco vuoi gestire?</b>"))

        self.list = QListWidget()
        for key, label, factory in GAMES:
            text = label if factory else f"{label} (solo da riga di comando per ora)"
            it = QListWidgetItem(text)
            it.setData(Qt.UserRole, (key, factory))
            if not factory:
                it.setForeground(QColor("#999999"))
            self.list.addItem(it)
        self.list.setCurrentRow(0)
        self.list.itemDoubleClicked.connect(lambda _: self.accept_choice())
        lay.addWidget(self.list)

        self.info = QLabel("")
        self.info.setWordWrap(True)
        lay.addWidget(self.info)

        row = QHBoxLayout()
        row.addStretch()
        btn_quit = QPushButton("Esci")
        btn_quit.clicked.connect(self.reject)
        self.btn_ok = QPushButton("Apri")
        self.btn_ok.clicked.connect(self.accept_choice)
        row.addWidget(btn_quit)
        row.addWidget(self.btn_ok)
        lay.addLayout(row)

    def accept_choice(self):
        it = self.list.currentItem()
        if it is None:
            return
        key, factory = it.data(Qt.UserRole)
        if factory is None:
            self.info.setText(
                f"Non ancora disponibile in GUI: usa 'pakrat {key} ...' da terminale.")
            return
        self.chosen = factory()
        self.accept()


class AdapterWorker(QThread):
    """Esegue un metodo batch dell'adapter (check/update/discover) fuori dal
    thread della UI: fanno tutti rete e/o I/O, e hanno la stessa forma
    (mods, on_row) -> messaggio riassuntivo. Un'unica classe invece di una per
    operazione, cosi' la gestione degli errori non puo' divergere fra le tre.
    """
    row_done = Signal(str, str)
    finished_all = Signal(str)

    def __init__(self, adapter, method, mods):
        super().__init__()
        self.adapter, self.method, self.mods = adapter, method, mods

    def run(self):
        try:
            fn = getattr(self.adapter, self.method)
            msg = fn(self.mods, lambda u, t: self.row_done.emit(u, t))
        except SystemExit as ex:
            msg = str(ex)
        except Exception as ex:
            msg = f"errore: {ex}"
        self.finished_all.emit(msg)


class SearchWorker(QThread):
    """Ricerca candidati su Nexus (rete): fuori dal thread della UI."""
    done = Signal(list, list)

    def __init__(self, adapter, mod, api_key, term=None):
        super().__init__()
        self.adapter, self.mod, self.api_key, self.term = adapter, mod, api_key, term

    def run(self):
        try:
            cands, errs = self.adapter.find_candidates(self.mod, self.api_key, extra_term=self.term)
        except core.NexusError as ex:
            self.done.emit([], [str(ex)])
            return
        self.done.emit(cands, errs)


class MatchDialog(QDialog):
    """Scelta manuale del corrispondente su Nexus fra i candidati trovati."""

    def __init__(self, parent, adapter, mod, api_key):
        super().__init__(parent)
