        self.btn_open.clicked.connect(self.open_selected)
        self.btn_ok = QPushButton("Associa la selezionata")
        self.btn_ok.clicked.connect(self.accept_choice)
        btn_skip = QPushButton("Nessuno di questi")
        btn_skip.clicked.connect(self.reject)
        row.addWidget(self.btn_open)
        row.addStretch()
        row.addWidget(btn_skip)
        row.addWidget(self.btn_ok)
        lay.addLayout(row)

        self.start_search(None)

    def start_search(self, term):
        self.info.setText("ricerca in corso...")
        self.btn_ok.setEnabled(False)
        self.worker = SearchWorker(self.adapter, self.mod, self.api_key, term)
        self.worker.done.connect(self.on_results)
        self.worker.start()

    def do_search(self):
        t = self.search_box.text().strip()
        self.start_search(t or None)

    def on_results(self, cands, errs):
        self.cands = cands
        self.list.setRowCount(len(cands))
        for r, (s, c) in enumerate(cands):
            up = (c.get("uploader") or {}).get("name", "")
            cells = [f"{s:.2f}", c["name"], up, str(c.get("version") or ""),
                     "adult" if c.get("adultContent") else ""]
            for col, text in enumerate(cells):
                it = QTableWidgetItem(text)
                if col == 0 and s >= 0.85:
                    it.setForeground(QColor("#33aa55"))
                elif col == 0 and s < 0.6:
                    it.setForeground(QColor("#999999"))
                self.list.setItem(r, col, it)
        msg = f"{len(cands)} candidati" if cands else "nessun candidato: prova altre parole"
        if errs:
            msg += " - " + "; ".join(errs)
        self.info.setText(msg)
        self.btn_ok.setEnabled(bool(cands))
        if cands:
            self.list.selectRow(0)

    def selected(self):
        r = self.list.currentRow()
        return self.cands[r][1] if 0 <= r < len(self.cands) else None

    def open_selected(self):
        c = self.selected()
        if c:
            QDesktopServices.openUrl(QUrl(self.adapter.mod_url(c['modId'])))

    def accept_choice(self):
        c = self.selected()
        if c:
            self.chosen = c
            self.accept()


class AccountWorker(QThread):
