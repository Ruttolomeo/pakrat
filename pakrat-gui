        self.info = QLabel("")
        self.info.setWordWrap(True)
        lay.addWidget(self.info)

        brow = QHBoxLayout()
        btn_rescan = QPushButton("Ricerca di nuovo")
        btn_rescan.clicked.connect(self.rescan)
        self.btn_ok = QPushButton("Usa questa cartella")
        self.btn_ok.clicked.connect(self.use_selected)
        btn_quit = QPushButton("Esci")
        btn_quit.clicked.connect(self.reject)
        brow.addWidget(btn_rescan)
        brow.addStretch()
        brow.addWidget(btn_quit)
        brow.addWidget(self.btn_ok)
        lay.addLayout(brow)

        self.rescan()

    def rescan(self):
        found = self.adapter.mod.detect_install_dirs()
        self.found = found
        self.list.clear()
        for p in found:
            self.list.addItem(p)
        if found:
            self.list.setCurrentRow(0)
            self.info.setText(f"{len(found)} installazioni trovate. "
                              "Scegline una, oppure indica un percorso a mano.")
        else:
            self.info.setText("Nessuna installazione trovata automaticamente. "
                              "Indica il percorso a mano qui sotto.")
        self.btn_ok.setEnabled(bool(found))

    def browse(self):
        d = QFileDialog.getExistingDirectory(
            self, f"Cartella di installazione di {self.adapter.label}",
            os.path.expanduser("~"))
        if d:
            self.path_box.setText(d)
            self.use_typed()

    def _apply(self, path):
        path = os.path.abspath(os.path.expanduser(path))
        if not self.adapter.mod._looks_like_install(path):
            self.info.setText(
                "<span style='color:#cc5555'>non sembra un'installazione di "
                f"{self.adapter.label}: {path}</span>")
            self.info.setTextFormat(Qt.RichText)
            return
        cfg, ns = self.adapter.mod.cfg_load()
        ns["install_dir"] = path
        self.adapter.mod.cfg_save(cfg)
        self.chosen = path
        self.accept()

    def use_typed(self):
        p = self.path_box.text().strip()
        if p:
            self._apply(p)

    def use_selected(self):
        p = self.path_box.text().strip()
        if p:
            self._apply(p)
            return
        r = self.list.currentRow()
        if 0 <= r < len(self.found):
            self._apply(self.found[r])


