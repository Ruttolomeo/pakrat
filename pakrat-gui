class BG3Adapter:
    """Fa da tramite fra la MainWindow (generica) e il core, l'unico dei tre
    backend nato con una GUI in mente."""

    key = "bg3"
    label = "Baldur's Gate 3"
    nexus_domain = "baldursgate3"
    supports_reorder = True
    supports_match = True
    supports_discover = True
    # rimuovere una mod cancella solo il .pak: la voce nel load order resta
    # nello stato finche' non si preme Salva, che riscrive modsettings.lsx
    removal_needs_save = True
    supports_backup_restore = True
    backup_prefix = "modsettings-"
    file_filter = "Mod BG3 (*.pak)"
    add_dialog_title = "Scegli un .pak"

    def is_configured(self):
        return bool(core.LARIAN) and os.path.isdir(core.LARIAN)

    def run_setup(self, parent=None):
        dlg = SetupDialog(parent)
        return dlg.exec() == QDialog.Accepted and bool(dlg.chosen)

    def is_installable(self, path):
        return path.lower().endswith(".pak")

    def build_state(self):
        return core.build_state()

    def install_pak(self, path):
        return core.install_pak(path)

    def write_state(self, state):
        return core.write_modsettings(state)

    def backup_dir(self):
        return core.BACKUP_DIR

    def modsettings_path(self):
        return core.MODSETTINGS

    def backup_now(self):
        return core.backup_modsettings()

    def remove_confirm(self, m):
        return True, f"Verra' cancellato il file:\n{m.pak}\n\nProcedere?"

    def remove(self, m):
        try:
            os.remove(m.pak)
        except OSError as ex:
            return False, str(ex)
        return True, f"eliminato {m.name}"

    def link(self, m, ref):
        nid = core.parse_nexus_ref(ref)
        cfg = core.load_config()
        cfg["mods"].setdefault(m.uuid, {}).update({"nexus_id": nid, "name": m.name})
        core.save_config(cfg)
        return nid

    def link_info(self, m):
        try:
            cfg = core.load_config()
        except SystemExit:
            return None
        return cfg.get("mods", {}).get(m.uuid, {}).get("nexus_id")

    def link_info_bulk(self, mods):
        """Come link_info ma su piu' mod, con un solo load_config()."""
        try:
            cfg = core.load_config()
        except SystemExit:
            return {m.uuid: None for m in mods}
        entries = cfg.get("mods", {})
        return {m.uuid: entries.get(m.uuid, {}).get("nexus_id") for m in mods}

    def set_link(self, m, mod_id, version=""):
        cfg = core.load_config()
        cfg["mods"].setdefault(m.uuid, {}).update(
            {"nexus_id": mod_id, "name": m.name, "installed_version": m.version,
             "remote_version": version})
        core.save_config(cfg)

    def find_candidates(self, mod, api_key, extra_term=None):
        return core.find_candidates(mod, api_key, extra_term=extra_term)

    def mod_page_url(self, mod_id):
        return core.mod_file_page_url(mod_id)

    def mod_url(self, mod_id):
        return f"https://www.nexusmods.com/{self.nexus_domain}/mods/{mod_id}"

    def mods_list_url(self):
        return f"https://www.nexusmods.com/{self.nexus_domain}/mods/"

    def check_updates(self, mods, on_row):
        cfg = core.load_config()
        if not cfg["nexus_api_key"]:
            return "API key Nexus non configurata (menu Nexus -> Imposta API key)"
        mapped = [m for m in mods
                  if m.uuid in cfg["mods"] and cfg["mods"][m.uuid].get("nexus_id")]
        if not mapped:
            return "nessuna mod associata a un ID Nexus: usa Nexus -> Associa a Nexus"
        errors = 0
        for m in mapped:
            entry = cfg["mods"][m.uuid]
            try:
                info = core.nexus_get(f"/mods/{entry['nexus_id']}.json", cfg["nexus_api_key"])
            except core.NexusError as ex:
                on_row(m.uuid, f"errore: {ex}")
                errors += 1
                continue
            remote = (info.get("version") or "").strip()
            local = entry.get("installed_version") or m.version
            if info.get("status") not in (None, "published"):
                on_row(m.uuid, f"mod {info.get('status')}")
            elif remote and remote != local:
                on_row(m.uuid, f"aggiornamento -> {remote}")
            else:
                on_row(m.uuid, "aggiornata")
            entry["remote_version"] = remote
        core.save_config(cfg)
        return (f"controllo completato su {len(mapped)} mod"
                + (f", {errors} errori" if errors else ""))

    def update_all(self, mods, on_row):
        cfg = core.load_config()
        ok = fail = 0
        for m in mods:
            entry = cfg["mods"].get(m.uuid, {})
            on_row(m.uuid, "aggiornamento...")
            try:
                good, res = core.update_mod(
                    m, entry, cfg["nexus_api_key"],
                    log=lambda s, u=m.uuid: on_row(u, s.strip()))
            except Exception as ex:
                good, res = False, f"errore: {ex}"
            on_row(m.uuid, res)
            ok += good
            fail += not good
            core.save_config(cfg)
        return f"aggiornate {ok}, non aggiornate {fail}"

    def discover_all(self, mods, on_row):
        cfg = core.load_config()
        found = miss = err = 0
        for m in mods:
            on_row(m.uuid, "hash...")
            try:
                digest = core.file_md5(m.pak)
            except OSError as ex:
                on_row(m.uuid, f"errore: {ex}")
                err += 1
                continue
            try:
                res = core.nexus_get(f"/mods/md5_search/{digest}.json", cfg["nexus_api_key"])
                info = res[0]["mod"]
            except core.NexusError as ex:
                if "404" in str(ex) or "non trovata" in str(ex):
                    on_row(m.uuid, "non su Nexus")
                    miss += 1
                else:
                    on_row(m.uuid, f"errore: {ex}")
                    err += 1
                continue
            except (KeyError, IndexError, TypeError):
                on_row(m.uuid, "risposta inattesa")
                miss += 1
                continue
            cfg["mods"].setdefault(m.uuid, {}).update(
                {"nexus_id": info["mod_id"], "name": m.name,
                 "installed_version": (info.get("version") or "").strip() or m.version})
            on_row(m.uuid, f"id {info['mod_id']}")
            found += 1
        core.save_config(cfg)
        return (f"identificate {found}, non trovate {miss}"
                + (f", errori {err}" if err else ""))


class BackendAdapter:
    """Adapter comune a MW5 e Cyberpunk.

    I due backend condividono la forma: stesso config.json (una chiave loro
    dentro, ns['mods'] chiavato su un identificatore locale), stessi nomi di
    funzione (scan_mods, set_enabled, remove_mod, update_one, remote_status,
    parse_ref, ...). Cambia solo quale attributo identifica una mod (folder
    per MW5, slug per Cyberpunk) e i dettagli passati alle sottoclassi.

    Niente identificazione via MD5 (nessuno dei due pubblica una mod come
    singolo file hashabile) e niente 'Associa a Nexus...' automatico (nessun
    backend fa ancora una ricerca per somiglianza come core.find_candidates):
    resta solo l'associazione manuale per ID/URL.
    """
    supports_reorder = False
    supports_match = False
    supports_discover = False
    supports_backup_restore = False
    backup_prefix = ""
    file_filter = "Archivi mod (*.zip *.rar *.7z)"
    add_dialog_title = "Scegli un archivio mod"
    # remove_mod aggiorna gia' file e config: lo stato in tabella dopo una
    # rimozione e' gia' quello salvato, a differenza di BG3
    removal_needs_save = False

    backend_name = None     # "mw5" / "cp2077"
    id_attr = ""            # "folder" / "slug"
    link_fn_name = ""       # "link_folder" / "link_slug"

    def __init__(self):
        self._mod = None
        self._orig_order = None

    @property
    def mod(self):
        if self._mod is None:
            self._mod = core.load_backend(self.backend_name)
        return self._mod

    def mod_key(self, m):
        return getattr(m, self.id_attr)

    def is_configured(self):
        return bool(self.mod.resolve_install_dir())

    def run_setup(self, parent=None):
        dlg = BackendSetupDialog(parent, self)
        return dlg.exec() == QDialog.Accepted and bool(dlg.chosen)

    def is_installable(self, path):
        return path.lower().endswith((".zip", ".rar", ".7z"))

    def build_state(self):
        install = self.mod.resolve_install_dir()
        mods = self.mod.scan_mods()
        ns = None     # caricata al piu' una volta, solo se serve a missing()
        for m in mods:
            m.uuid = self.mod_key(m)
            m.is_base = False
            m.pak = None
            # istantanea dello stato letto da disco: write_state la confronta
            # con quello che l'utente ha effettivamente cambiato, invece di
            # riscrivere tutto ogni volta che si preme Salva
            m._orig_enabled = m.enabled
            if not hasattr(m, "author"):
                m.author = ""
            if not hasattr(m, "has_pak"):
                if install and hasattr(m, "missing"):
                    if ns is None:
                        _cfg, ns = self.mod.cfg_load()
                    m.has_pak = not m.missing(install, ns)
                else:
                    m.has_pak = True
        self._orig_order = [self.mod_key(m) for m in mods]
        return mods, []

    def install_pak(self, path):
        if self.mod.game_running():
            return False, f"{self.label} e' aperto: chiudilo prima di installare una mod"
        try:
            got = self.mod.install_archive(path)
        except Exception as ex:
            return False, str(ex)
        if not got:
            return False, "installazione non riuscita (nessuna mod riconosciuta nell'archivio)"
        name = got[0] if isinstance(got, list) else got
        return True, f"installata: {name}"

    def write_state(self, state):
        """Scrive solo cio' che e' davvero cambiato rispetto a build_state().

        Un riordino globale su MW5 riscrive il mod.json di ogni mod (author
        file), e su Cyberpunk un enable/disable sposta file di gioco: farlo
        per tutte le mod a ogni Salva, anche quando l'utente ha solo spuntato
        una casella, sarebbe una scrittura di massa non richiesta.
        """
        if self.mod.game_running():
            return False, f"{self.label} e' aperto: chiudilo prima di salvare"
        orig_order = self._orig_order if self._orig_order is not None else \
            [self.mod_key(m) for m in state]
        to_on = [m for m in state if m.enabled and not getattr(m, "_orig_enabled", m.enabled)]
        to_off = [m for m in state if not m.enabled and getattr(m, "_orig_enabled", m.enabled)]
        want_order = [self.mod_key(m) for m in state]
        order_changed = self.supports_reorder and want_order != orig_order
        if not to_on and not to_off and not order_changed:
            return True, "nessuna modifica da salvare"
        touched = {self.mod_key(m) for m in to_on} | {self.mod_key(m) for m in to_off}
        applied = set()
        skipped = []
        try:
            if to_on:
                keys = [self.mod_key(m) for m in to_on]
                done = set(self.mod.set_enabled(keys, True))
                applied |= done
                skipped += [k for k in keys if k not in done]
            if to_off:
                keys = [self.mod_key(m) for m in to_off]
                done = set(self.mod.set_enabled(keys, False))
                applied |= done
                skipped += [k for k in keys if k not in done]
            if order_changed:
                changed = self.mod.reorder(want_order)
                changed_keys = {k for k, _n in changed}
                skipped += [k for k in want_order if k not in changed_keys]
        except Exception as ex:
            return False, str(ex)
        for m in state:
            key = self.mod_key(m)
            if key not in touched or key in applied:
                m._orig_enabled = m.enabled
        if order_changed:
            self._orig_order = want_order
        if skipped:
            uniq = sorted(set(skipped))
            return False, (f"{len(uniq)} mod non applicate (gioco aperto o file "
                          "mancanti): " + ", ".join(uniq[:5]))
        n = len(to_on) + len(to_off)
        return True, f"{n} mod aggiornate" + (", ordine aggiornato" if order_changed else "")

    def backup_dir(self):
        return core.BACKUP_DIR

    def remove_confirm(self, m):
        return True, (f"'{m.name}' verra' rimossa (spostata in archivio, non "
                      "cancellata).\n\nProcedere?")

    def remove(self, m):
        if self.mod.game_running():
            return False, f"{self.label} e' aperto: chiudilo prima di rimuovere una mod"
        try:
            dest = self.mod.remove_mod(self.mod_key(m))
        except Exception as ex:
            return False, str(ex)
        if dest is None:
            return False, "non rimossa"
        return True, ("cancellata" if dest == "" else f"spostata in archivio: {dest}")

    def link(self, m, ref):
        nid = self.mod.parse_ref(ref)
        cfg, ns = self.mod.cfg_load()
        getattr(self.mod, self.link_fn_name)(self.mod_key(m), nid, ns)
        self.mod.cfg_save(cfg)
        return nid

    def link_info(self, m):
        try:
            _cfg, ns = self.mod.cfg_load()
        except SystemExit:
            return None
        return (ns.get("mods", {}).get(self.mod_key(m)) or {}).get("nexus_id")

    def link_info_bulk(self, mods):
        """Come link_info ma su piu' mod, con un solo cfg_load()."""
        try:
            _cfg, ns = self.mod.cfg_load()
        except SystemExit:
            return {m.uuid: None for m in mods}
        entries = ns.get("mods", {})
        return {m.uuid: (entries.get(self.mod_key(m)) or {}).get("nexus_id") for m in mods}

    def set_link(self, m, mod_id, version=""):
        cfg, ns = self.mod.cfg_load()
        getattr(self.mod, self.link_fn_name)(self.mod_key(m), mod_id, ns, version=version)
        self.mod.cfg_save(cfg)

    def find_candidates(self, mod, api_key, extra_term=None):
        raise NotImplementedError("associazione automatica non disponibile per questo gioco")

    def mod_page_url(self, mod_id):
        return self.mod.mod_page_url(mod_id)

    def mod_url(self, mod_id):
        return f"https://www.nexusmods.com/{self.nexus_domain}/mods/{mod_id}"

    def mods_list_url(self):
        return f"https://www.nexusmods.com/{self.nexus_domain}/mods/"

    def check_updates(self, mods, on_row):
        cfg, ns = self.mod.cfg_load()
        api_key = cfg.get("nexus_api_key")
        if not api_key:
            return "API key Nexus non configurata (menu Nexus -> Imposta API key)"
        mapped = [m for m in mods
                  if (ns.get("mods", {}).get(self.mod_key(m)) or {}).get("nexus_id")]
        if not mapped:
            return "nessuna mod associata a un ID Nexus: usa Nexus -> Associa per ID/URL"
        errors = 0
        for m in mapped:
            key = self.mod_key(m)
            e = ns["mods"][key]
            try:
                files = self.mod.nexus_get(f"/mods/{e['nexus_id']}/files.json",
                                           api_key).get("files", [])
            except core.NexusError as ex:
                on_row(key, f"errore: {ex}")
                errors += 1
                continue
            state, _f, rv, note = self.mod.remote_status(files, e)
            label = {
                "update": f"aggiornamento -> {rv or '?'}",
                "gone": f"! {note}" if note else "non piu' su Nexus",
                "variant": f"aggiornata ({note})" if note else "aggiornata",
                "unknown": "non verificabile (reinstalla per registrare il file)",
            }.get(state, "aggiornata")
            on_row(key, label)
            e["remote_version"] = rv
        self.mod.cfg_save(cfg)
        return (f"controllo completato su {len(mapped)} mod"
                + (f", {errors} errori" if errors else ""))

    def update_all(self, mods, on_row):
        install = self.mod.resolve_install_dir()
        cfg, ns = self.mod.cfg_load()
        api_key = cfg.get("nexus_api_key")
        ok = fail = 0
        for m in mods:
            key = self.mod_key(m)
            # entry letta una volta sola all'inizio: update_one salva la sua
            # copia internamente, non serve ricaricare da disco a ogni giro
            entry = ns.get("mods", {}).get(key, {})
            on_row(key, "aggiornamento...")
            try:
                good, res = self.mod.update_one(
                    m, entry, api_key, install,
                    log=lambda s, u=key: on_row(u, s.strip()))
            except Exception as ex:
                good, res = False, f"errore: {ex}"
            on_row(key, res)
            ok += good
            fail += not good
        return f"aggiornate {ok}, non aggiornate {fail}"

    def discover_all(self, mods, on_row):
        raise NotImplementedError("identificazione via MD5 non disponibile per questo gioco")


