HEADERS = ["", "#", "Mod", "Versione", "Autore", "Nexus"]


class CheckWorker(QThread):
    """Il controllo aggiornamenti fa rete: fuori dal thread della UI."""
    row_done = Signal(str, str)
    finished_all = Signal(str)

    def __init__(self, mods):
        super().__init__()
        self.mods = mods

    def run(self):
        try:
            cfg = core.load_config()
        except SystemExit as ex:
            self.finished_all.emit(str(ex))
            return
        if not cfg["nexus_api_key"]:
            self.finished_all.emit("API key Nexus non configurata (menu Nexus -> Imposta API key)")
            return
        mapped = [m for m in self.mods
                  if m.uuid in cfg["mods"] and cfg["mods"][m.uuid].get("nexus_id")]
        if not mapped:
            self.finished_all.emit("nessuna mod associata a un ID Nexus: usa Nexus -> Associa a Nexus")
            return
        errors = 0
        for m in mapped:
            entry = cfg["mods"][m.uuid]
            try:
                info = core.nexus_get(f"/mods/{entry['nexus_id']}.json", cfg["nexus_api_key"])
            except core.NexusError as ex:
                self.row_done.emit(m.uuid, f"errore: {ex}")
                errors += 1
                continue
            remote = (info.get("version") or "").strip()
            local = entry.get("installed_version") or m.version
            if info.get("status") not in (None, "published"):
                self.row_done.emit(m.uuid, f"mod {info.get('status')}")
            elif remote and remote != local:
                self.row_done.emit(m.uuid, f"aggiornamento -> {remote}")
            else:
                self.row_done.emit(m.uuid, "aggiornata")
            entry["remote_version"] = remote
        core.save_config(cfg)
        self.finished_all.emit(f"controllo completato su {len(mapped)} mod"
                               + (f", {errors} errori" if errors else ""))


class SearchWorker(QThread):
    """Ricerca candidati su Nexus (rete): fuori dal thread della UI."""
    done = Signal(list, list)

    def __init__(self, mod, api_key, term=None):
        super().__init__()
        self.mod, self.api_key, self.term = mod, api_key, term

    def run(self):
        try:
            cands, errs = core.find_candidates(self.mod, self.api_key, extra_term=self.term)
        except core.NexusError as ex:
            self.done.emit([], [str(ex)])
            return
        self.done.emit(cands, errs)


