    # ----------------------------------------------------------- dati ---
    def reload(self):
        self.state, errors = core.build_state()
        self.nexus_status = {}
        self.dirty = False
        self.refresh_key_button()
        self.refresh_account()
        self.refresh_table()
        n_on = len([m for m in self.state if m.enabled])
        msg = f"{n_on} mod attive su {len(self.state)}"
        if errors:
            msg += f" - {len(errors)} avvisi: " + "; ".join(errors)
        self.statusBar().showMessage(msg)

    def refresh_key_button(self):
        """Mostra sul pulsante se la API key c'e' o manca."""
        try:
            key = core.load_config()["nexus_api_key"]
        except SystemExit:
            key = ""
        if key:
            self.btn_key.setText("API key ✓")
            self.btn_key.setToolTip(f"API key Nexus configurata ({key[:6]}...).\n"
                                    "Clicca per sostituirla.")
        else:
            self.btn_key.setText("Imposta API key...")
            self.btn_key.setToolTip("Serve per il controllo aggiornamenti e i download.\n"
                                    "nexusmods.com -> Site preferences -> API Keys")
        self.btn_check.setEnabled(bool(key))
        self.btn_update.setEnabled(bool(key))
        return bool(key)

    def refresh_table(self):
        self.table.setRowCount(len(self.state))
        pos = 0
        for row, m in enumerate(self.state):
            cb = QCheckBox()
            cb.setChecked(m.enabled)
            cb.setEnabled(not m.is_base and m.has_pak)
            cb.stateChanged.connect(lambda st, mm=m: self.toggle(mm, st))
            holder = QWidget()
            lay = QHBoxLayout(holder)
            lay.setContentsMargins(6, 0, 0, 0)
            lay.addWidget(cb)
            self.table.setCellWidget(row, COL_ON, holder)

            if m.enabled:
                pos += 1
                num = str(pos)
            else:
                num = "-"
            if m.is_base:
                # non sono mod: vengono col gioco e su Nexus non esistono
                author = "modulo base del gioco"
                nexus = "no"
            else:
                author = m.author
                nexus = self.nexus_status.get(m.uuid, "")
            cells = [num, m.name, m.version, author, nexus]
            for off, text in enumerate(cells, start=COL_NUM):
                it = QTableWidgetItem(text)
                if off in (COL_NUM, COL_VER):
                    it.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
                if m.is_base:
                    it.setForeground(QColor("#6699cc"))
                elif m.enabled and not m.has_pak:
                    it.setForeground(QColor("#cc5555"))
                elif not m.enabled:
                    it.setForeground(QColor("#999999"))
                if off == COL_NEXUS and text.startswith("aggiornamento"):
                    it.setForeground(QColor("#ddaa33"))
                self.table.setItem(row, off, it)
        self.setWindowTitle("pakrat" + (" *" if self.dirty else ""))

    def sel_row(self):
        r = self.table.currentRow()
        return r if 0 <= r < len(self.state) else -1

    # ---------------------------------------------------------- azioni ---
    def toggle(self, mod, st):
        mod.enabled = bool(st)
        self.dirty = True
        self.refresh_table()

    def move_sel(self, delta):
        r = self.sel_row()
        if r < 0:
            return
        j = r + delta
        if not (0 <= j < len(self.state)):
            return
        if self.state[r].is_base or self.state[j].is_base:
            self.statusBar().showMessage("i moduli base restano in testa")
            return
        self.state[r], self.state[j] = self.state[j], self.state[r]
        self.dirty = True
        self.refresh_table()
        self.table.selectRow(j)

    def add_pak(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Scegli un .pak", os.path.expanduser("~/Downloads"),
            "Mod BG3 (*.pak)")
        if path:
            self.install(path)

    def install(self, path):
        ok, res = core.install_pak(path)
        self.statusBar().showMessage(res)
        if ok:
            self.reload()
        else:
            QMessageBox.warning(self, "Installazione non riuscita", res)

    def delete_sel(self):
        r = self.sel_row()
        if r < 0:
            return
        m = self.state[r]
        if m.is_base:
            QMessageBox.information(self, "pakrat", "Non si elimina un modulo base del gioco.")
            return
        if not m.has_pak:
            self.state.pop(r)
            self.dirty = True
            self.refresh_table()
            return
        if QMessageBox.question(
                self, "Eliminare la mod?",
                f"Verra' cancellato il file:\n{m.pak}\n\nProcedere?") != QMessageBox.Yes:
            return
        try:
            os.remove(m.pak)
        except OSError as ex:
            QMessageBox.critical(self, "Errore", str(ex))
            return
        self.state.pop(r)
        self.dirty = True
        self.refresh_table()
        self.statusBar().showMessage(f"eliminato {m.name}")

    def save(self):
        ok, res = core.write_modsettings(self.state)
        if ok:
            self.dirty = False
            self.refresh_table()
            self.statusBar().showMessage("salvato: " + res)
        else:
            QMessageBox.critical(self, "Non salvato", res)

    def change_game_dir(self):
        dlg = SetupDialog(self)
        if dlg.exec() == QDialog.Accepted and dlg.chosen:
            self.reload()
            self.statusBar().showMessage(f"cartella di gioco: {dlg.chosen}")

    def restore_backup(self):
        d = core.BACKUP_DIR
        if not os.path.isdir(d) or not os.listdir(d):
            QMessageBox.information(self, "pakrat", "Nessun backup disponibile.")
            return
        files = sorted((f for f in os.listdir(d) if f.startswith("modsettings-")),
                       reverse=True)
        item, ok = QInputDialog.getItem(self, "Ripristina backup",
                                        "Backup da ripristinare:", files, 0, False)
        if ok and item:
            import shutil
            core.backup_modsettings()
            shutil.copy2(os.path.join(d, item), core.MODSETTINGS)
            self.reload()
            self.statusBar().showMessage(f"ripristinato {item}")

    # ----------------------------------------------------------- nexus ---
    def set_apikey(self):
        cfg = core.load_config()
        key, ok = QInputDialog.getText(
            self, "API key Nexus",
            "Personal API Key (nexusmods.com -> Site preferences -> API Keys):",
            text=cfg["nexus_api_key"])
        if ok:
            key = key.strip()
            if len(key) < 20:
                QMessageBox.warning(self, "pakrat", "La chiave sembra incompleta.")
                return
            cfg["nexus_api_key"] = key
            core.save_config(cfg)
            cfg2 = core.load_config(); cfg2.pop("account", None); core.save_config(cfg2)
            self.refresh_key_button()
            self.refresh_account()
            self.statusBar().showMessage("API key salvata")

    def link_nexus(self):
        r = self.sel_row()
        if r < 0:
            return
        m = self.state[r]
        ref, ok = QInputDialog.getText(
            self, "Associa a Nexus",
            f"URL o ID Nexus per '{m.name}':")
        if not ok or not ref.strip():
            return
        try:
            nid = core.parse_nexus_ref(ref)
        except core.NexusError as ex:
            QMessageBox.warning(self, "pakrat", str(ex))
            return
        cfg = core.load_config()
        cfg["mods"].setdefault(m.uuid, {}).update({"nexus_id": nid, "name": m.name})
        core.save_config(cfg)
        self.nexus_status[m.uuid] = f"id {nid}"
        self.refresh_table()

    def browse_nexus(self):
        """Apre Nexus: la pagina della mod selezionata se associata, altrimenti
        l'elenco mod di Baldur's Gate 3."""
        url = "https://www.nexusmods.com/baldursgate3/mods/"
        what = "elenco mod di BG3"
        r = self.sel_row()
        if r >= 0:
            m = self.state[r]
            try:
                cfg = core.load_config()
            except SystemExit:
                cfg = {"mods": {}}
            nid = cfg.get("mods", {}).get(m.uuid, {}).get("nexus_id")
            if nid:
                url = f"https://www.nexusmods.com/baldursgate3/mods/{nid}"
                what = m.name
        if not QDesktopServices.openUrl(QUrl(url)):
            QMessageBox.warning(self, "pakrat",
                                f"Impossibile aprire il browser.\nURL: {url}")
            return
        self.statusBar().showMessage(f"aperto su Nexus: {what}")

    def refresh_account(self):
        """Interroga il tipo di account e adatta il pulsante di aggiornamento.

        Una sola interfaccia per premium e free: cambia solo cosa fa il pulsante,
        perche' gli account free non possono ottenere link diretti dall'API e
        devono passare dal pulsante di download sul sito.
        """
        try:
            cfg = core.load_config()
        except SystemExit:
            return
        if not cfg["nexus_api_key"]:
            self.account = {}
            self.apply_account()
            return
        self.acct_worker = AccountWorker(cfg["nexus_api_key"])
        self.acct_worker.done.connect(self.on_account)
        self.acct_worker.start()

    def on_account(self, acct):
        self.account = acct or {}
        self.apply_account()

    def apply_account(self):
        premium = bool(self.account.get("is_premium"))
        name = self.account.get("name", "")
        if not self.account:
            self.btn_update.setText("Aggiorna")
            self.btn_update.setToolTip("Imposta la API key per abilitare gli aggiornamenti.")
            self.lbl_acct.setText("")
            return
        if premium:
            self.btn_update.setText("Aggiorna")
            self.btn_update.setToolTip(
                "Scarica e installa l'ultima versione da Nexus.\n"
                "Account premium: download diretto, senza browser.")
            self.lbl_acct.setText(f"{name} · premium")
        else:
            self.btn_update.setText("Aggiorna (via browser)")
            self.btn_update.setToolTip(
                "Account non premium: Nexus non rilascia link diretti all'API.\n"
                "Si apre la pagina della mod, tu clicchi 'Mod Manager Download'\n"
                "e il download viene raccolto automaticamente.")
            self.lbl_acct.setText(f"{name} · account free")

    def update_via_browser(self, pool):
        """Percorso per account free: apre le pagine di download delle mod."""
        cfg = core.load_config()
        if not os.path.exists(os.path.expanduser(
                "~/.local/share/applications/pakrat-nxm.desktop")):
            r = QMessageBox.question(
                self, "Handler nxm:// non registrato",
                "Per raccogliere i download dal browser serve l'handler nxm://.\n"
                "Lo registro adesso?")
            if r == QMessageBox.Yes:
                self.install_handler()
        opened = 0
        for m in pool[:5]:          # non sommergere l'utente di schede
            nid = cfg["mods"].get(m.uuid, {}).get("nexus_id")
            if not nid:
                continue
            QDesktopServices.openUrl(QUrl(core.mod_file_page_url(nid)))
            opened += 1
        rest = max(0, len([m for m in pool if cfg["mods"].get(m.uuid, {}).get("nexus_id")]) - opened)
        msg = (f"aperte {opened} pagine: clicca 'Mod Manager Download' su ciascuna, "
               "il resto e' automatico")
        if rest:
            msg += f" ({rest} rimanenti, rilancia dopo)"
        self.statusBar().showMessage(msg)

    def do_update(self):
        """Scarica e installa gli aggiornamenti delle mod associate a Nexus."""
        if self.worker and self.worker.isRunning():
            return
        try:
            cfg = core.load_config()
        except SystemExit as ex:
            QMessageBox.critical(self, "pakrat", str(ex))
            return
        if not cfg["nexus_api_key"]:
            QMessageBox.information(self, "pakrat", "Prima imposta la API key Nexus.")
            return
        r = self.sel_row()
        sel = self.state[r] if r >= 0 else None
        if sel is not None and cfg["mods"].get(sel.uuid, {}).get("nexus_id"):
            pool, what = [sel], f"'{sel.name}'"
        else:
            pool = [m for m in self.state
                    if m.has_pak and cfg["mods"].get(m.uuid, {}).get("nexus_id")]
            what = f"tutte le {len(pool)} mod associate"
        if not pool:
            QMessageBox.information(
                self, "pakrat",
                "Nessuna mod associata a Nexus.\nUsa 'Associa a Nexus...' per collegarle.")
            return
        if not self.account.get("is_premium", False):
            self.update_via_browser(pool)
            return
        if QMessageBox.question(
                self, "Aggiornare?",
                f"Scarico e installo l'ultima versione di {what}.\n\n"
                "Il .pak esistente viene sostituito solo se quello scaricato ha lo\n"
                "stesso UUID, cosi' il load order resta valido.\n\nProcedere?"
        ) != QMessageBox.Yes:
            return
        self.btn_update.setEnabled(False)
        self.btn_check.setEnabled(False)
        self.statusBar().showMessage("aggiornamento in corso...")
        self.worker = UpdateWorker(pool)
        self.worker.row_done.connect(self.on_row_done)
        self.worker.finished_all.connect(self.on_update_done)
        self.worker.start()

    def on_update_done(self, msg):
        self.btn_update.setEnabled(True)
        self.btn_check.setEnabled(True)
        self.statusBar().showMessage(msg)
        keep = dict(self.nexus_status)
        self.reload()
        self.nexus_status = keep
        self.refresh_table()

    def match_selected(self):
        """Cerca su Nexus la mod selezionata e fa scegliere fra i candidati."""
        r = self.sel_row()
        if r < 0:
            QMessageBox.information(self, "pakrat", "Seleziona prima una mod.")
            return
        m = self.state[r]
        if m.is_base:
            QMessageBox.information(self, "pakrat",
                                    "I moduli base del gioco non stanno su Nexus.")
            return
        try:
            cfg = core.load_config()
        except SystemExit as ex:
            QMessageBox.critical(self, "pakrat", str(ex))
            return
        if not cfg["nexus_api_key"]:
            QMessageBox.information(self, "pakrat", "Prima imposta la API key Nexus.")
            return
        dlg = MatchDialog(self, m, cfg["nexus_api_key"])
        if dlg.exec() == QDialog.Accepted and dlg.chosen:
            c = dlg.chosen
            cfg = core.load_config()
            cfg["mods"].setdefault(m.uuid, {}).update(
                {"nexus_id": c["modId"], "name": m.name,
                 "installed_version": m.version,
                 "remote_version": (c.get("version") or "").strip()})
            core.save_config(cfg)
            self.nexus_status[m.uuid] = f"id {c['modId']}"
            self.refresh_table()
            self.statusBar().showMessage(f"{m.name} associata a mods/{c['modId']}")

    def discover_nexus(self):
        """Identifica via MD5 le mod non ancora associate a Nexus."""
        if self.worker and self.worker.isRunning():
            return
        try:
            cfg = core.load_config()
        except SystemExit as ex:
            QMessageBox.critical(self, "pakrat", str(ex))
            return
        if not cfg["nexus_api_key"]:
            QMessageBox.information(self, "pakrat",
                                    "Prima imposta la API key Nexus.")
            return
        todo = [m for m in self.state
                if m.has_pak and not m.is_base
                and not cfg["mods"].get(m.uuid, {}).get("nexus_id")]
        if not todo:
            QMessageBox.information(self, "pakrat",
                                    "Tutte le mod con un .pak sono gia' associate.")
            return
        mb = sum(os.path.getsize(m.pak) for m in todo) / (1 << 20)
        if QMessageBox.question(
                self, "Identifica via MD5",
                f"Calcolo l'hash di {len(todo)} mod ({mb:.0f} MB) e le cerco su Nexus.\n"
                "Funziona per le mod pubblicate come .pak singolo; per quelle dentro\n"
                "un archivio zip servira' l'associazione manuale.\n\nProcedere?"
        ) != QMessageBox.Yes:
            return
        self.btn_check.setEnabled(False)
        self.statusBar().showMessage("identificazione in corso...")
        self.worker = DiscoverWorker(todo)
        self.worker.row_done.connect(self.on_row_done)
        self.worker.finished_all.connect(self.on_check_done)
        self.worker.start()

    def check_updates(self):
        if self.worker and self.worker.isRunning():
            return
        self.btn_check.setEnabled(False)
        self.statusBar().showMessage("controllo aggiornamenti in corso...")
        self.worker = CheckWorker(list(self.state))
        self.worker.row_done.connect(self.on_row_done)
        self.worker.finished_all.connect(self.on_check_done)
        self.worker.start()

    def on_row_done(self, uuid, text):
        self.nexus_status[uuid] = text
        self.refresh_table()

    def on_check_done(self, msg):
        self.btn_check.setEnabled(True)
        self.statusBar().showMessage(msg)

    def install_handler(self):
        import subprocess
        r = subprocess.run([CORE_PATH, "handler"], capture_output=True, text=True)
        QMessageBox.information(self, "Handler nxm://",
                                (r.stdout or "") + (r.stderr or ""))

    # ------------------------------------------------------ drag & drop ---
    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls() and any(
                u.toLocalFile().lower().endswith(".pak") for u in e.mimeData().urls()):
            e.acceptProposedAction()

    def dropEvent(self, e):
        for u in e.mimeData().urls():
            p = u.toLocalFile()
            if p.lower().endswith(".pak"):
                self.install(p)

    def closeEvent(self, e):
        if self.dirty:
            r = QMessageBox.question(
                self, "Modifiche non salvate",
                "Il load order e' stato modificato ma non salvato.\nSalvare prima di uscire?",
                QMessageBox.Save | QMessageBox.Discard | QMessageBox.Cancel)
            if r == QMessageBox.Cancel:
                e.ignore()
                return
            if r == QMessageBox.Save:
                self.save()
        e.accept()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("pakrat")
    if not core.LARIAN or not os.path.isdir(core.LARIAN):
        # primo avvio, o installazione spostata: chiedi dov'e' il gioco
        dlg = SetupDialog()
        if dlg.exec() != QDialog.Accepted:
            return 1
    w = MainWindow()
    w.show()
    if os.environ.get("PAKRAT_SCREENSHOT"):
        from PySide6.QtCore import QTimer
        def shot():
            w.grab().save(os.environ["PAKRAT_SCREENSHOT"])
            app.quit()
        QTimer.singleShot(600, shot)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
